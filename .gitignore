# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# sqlite dev database — dữ liệu cục bộ, khôi phục bằng `npx prisma migrate dev` + `npm run db:seed`
/prisma/dev.db
/prisma/dev.db-journal

# chat attachment binaries (local disk, ngoài public/ — xem src/lib/chat-storage.ts)
/storage

# HS&E manual generator — isolated Node deps (docx/puppeteer). Source scripts committed; deps not.
/docs/hse/node_modules

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
