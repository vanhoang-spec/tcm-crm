// TCM — Nền tảng tối thiểu + Module ① Khách hàng
// SQLite cho dev (dễ chạy local). Chuyển sang PostgreSQL khi lên staging/production
// chỉ cần đổi provider + DATABASE_URL — schema giữ nguyên (tránh dùng tính năng riêng của sqlite).
// Enum "mềm" (industry, ...) đi qua OptionSet/OptionItem để admin tự cấu hình (không hard-code).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// NỀN TẢNG — Identity / Tổ chức
// ─────────────────────────────────────────────────────────

model Department {
  id          String  @id @default(cuid())
  code        String  @unique // ACCOUNT | PLANNING | CREATIVE | OPE | PRO | PCC | FIN | HR | CEO
  name        String
  leadStaffId String? // trưởng bộ phận — người xếp lịch ca cho NV trong bộ phận (module ⑤)
  isActive    Boolean @default(true)
  /// Tiền tố 3 ký tự sinh mã dòng chi phí CO/CE: ACC-001, OPE-002… (module ④ theo dõi thanh toán
  /// từng dòng). Sửa ở /settings/teams. Null = phòng không nhận chi phí trực tiếp.
  costPrefix  String?

  lead          Staff?         @relation("DepartmentLead", fields: [leadStaffId], references: [id])
  staff         Staff[]

  @@map("department")
}

model Role {
  id           String  @id @default(cuid())
  code         String  @unique // ADMIN | BOARD_OF_MANAGEMENT | CFO | ACCOUNTANT_STAFF | HR_MANAGER | HR_STAFF | ADMIN_STAFF | ACCOUNT_DIRECTOR | ACCOUNT_MANAGER | ACCOUNT_STAFF | CREATIVE_DIRECTOR | CREATIVE_STAFF | PLANNING_MANAGER | PLANNING_STAFF | OPERATIONS_MANAGER | OPERATIONS_STAFF | PRODUCTION_MANAGER | PRODUCTION_STAFF | PURCHASING_MANAGER | PURCHASING_STAFF
  name         String
  description  String? // mô tả phạm vi xem được (chỉ tài liệu — nominal, chưa gate tính năng thật)
  groupCode    String // nhóm hiển thị: ADMIN | BOD | FINANCE | HR | ACCOUNT | CREATIVE | PLANNING | OPERATIONS | PRODUCTION | PURCHASING
  parentRoleId String? // role cấp trên trực tiếp (vd ACCOUNT_STAFF → ACCOUNT_MANAGER → ACCOUNT_DIRECTOR)
  sort         Int     @default(0)
  isActive     Boolean @default(true)

  parent      Role?            @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  children    Role[]           @relation("RoleHierarchy")
  staff       Staff[]
  permissions RolePermission[]

  @@map("role")
}

model RolePermission {
  id             String @id @default(cuid())
  roleId         String
  permissionCode String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionCode])
  @@index([roleId])
  @@map("role_permission")
}

model Staff {
  id              String    @id @default(cuid())
  code            String?   @unique
  fullName        String
  email           String    @unique
  phone           String?
  title           String?
  departmentId    String?
  roleId          String? // Role phân quyền (bảng phân quyền, /settings/roles) — nominal, chưa gate tính năng thật
  avatarKey       String? // storageKey ảnh đại diện (storage/staff-avatars, xem lib/staff-avatar-storage.ts) — user tự đổi ở /profile
  dateOfBirth     DateTime? // nullable ở DB (nhân sự seed cũ/legacy có thể thiếu) — form tạo mới BẮT BUỘC nhập (DD/MM/YYYY), enforce ở validator
  firstWorkDate   DateTime? // nullable ở DB (legacy) — form tạo mới BẮT BUỘC nhập (DD/MM/YYYY); "ngày đi làm đầu tiên" thật,
  // CÓ THỂ khác createdAt (ngày được add vào CRM) — dùng cho tin nhắn Work Anniversary (xem lib/occasions.ts)
  isActive        Boolean   @default(true)
  /// TCM KHÔNG trả lương cho người này (thủ kho/bảo vệ điểm kho do bên thứ ba trả — quyết định chủ
  /// dự án 28/07/2026). VẪN xếp ca và hiện trên bảng công để THAM CHIẾU, nhưng bị loại khỏi mọi
  /// chỗ tiêu tiền: quỹ KPI 75/25 (lib/kpi.ts), quỹ lương Creative (lib/creative-cost.ts) và
  /// phép năm (lib/timekeeping.ts — phép là phúc lợi có lương).
  /// ⚠ ĐỪNG thay bằng cách nhập lương 0 ở PositionSalary: 0 ≠ null nên người đó vẫn nằm trong
  /// nhóm đủ điều kiện và VẪN ĂN share thật của quỹ KPI (xem kpi.ts, nhánh `salary == null`).
  payrollExempt   Boolean   @default(false)
  /// Người này LÀM function Planning (viết proposal, research, design brief) — quyết định chủ dự án
  /// 01/08/2026: bộ phận Planning độc lập giải thể, nhân sự Planning về thẳng các team Account, nên
  /// "ai là người Planning" KHÔNG còn suy được từ `departmentId` nữa.
  /// ⚠ Đây là NGUỒN SỰ THẬT DUY NHẤT cho ô "Giao cho" của tab Planning. Đừng thêm đường lọc thứ hai
  /// theo phòng ban song song với cờ này — hai nguồn mâu thuẫn chính là gốc của 5 lỗ hổng phân quyền
  /// phải vá 30/07 (HANDOVER 10.15).
  /// ⚠ CỐ Ý KHÔNG lọc thêm theo team ở ô chọn: hiện chỉ có 1 người Planning cho 2 team Account, lọc
  /// cứng theo team là team còn lại không giao được việc cho ai. Nhãn ô chọn có ghi tên team để người
  /// giao tự biết mình đang mượn người của team khác.
  isPlanningStaff Boolean   @default(false)
  /// CR-1 (06/08/2026): team NHỎ trong phòng Creative mà người này thuộc về — đúng MỘT team
  /// (quyết định chủ dự án). ⚠ ĐỪNG NHẦM với `teamId` = team ACCOUNT (A1/A2/A3). Gán ở
  /// /settings/creative-squads; null = chưa phân team, CD vẫn giao thẳng việc được.
  creativeSquadId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── Đăng nhập (xem src/lib/password.ts + src/lib/auth-session.ts) ──
  passwordHash       String? // scrypt, định dạng "scrypt$N$r$p$salt$hash". null = chưa đặt → phải dùng mật khẩu mặc định
  passwordChangedAt  DateTime? // mốc tính hạn 12 tháng (PASSWORD_MAX_AGE_DAYS)
  mustChangePassword Boolean   @default(true) // true = ép đổi ngay lần đăng nhập kế (lần đầu, hoặc admin vừa cấp lại)
  failedLoginCount   Int       @default(0) // reset về 0 khi đăng nhập đúng
  lockedUntil        DateTime? // khoá tạm sau nhiều lần sai liên tiếp (chống dò mật khẩu)
  lastLoginAt        DateTime?

  gender       String? // "Nam" | "Nữ" — text thuần, không module nào khác cần catalog cấu hình được cho field này
  workLocation String? // "TPHCM" | "HÀ NỘI" — text thuần, chỉ hiển thị
  managerId    String? // NGƯỜI quản lý trực tiếp thật (khác Role.parentRoleId — đó là phân cấp role chung, không phải người cụ thể) — dùng dựng org chart

  department    Department?    @relation(fields: [departmentId], references: [id])
  creativeSquad CreativeSquad? @relation("StaffCreativeSquad", fields: [creativeSquadId], references: [id])
  role          Role?          @relation(fields: [roleId], references: [id])
  manager    Staff?      @relation("StaffManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports    Staff[]     @relation("StaffManager")

  passwordResets PasswordResetToken[]

  introducedClients           Client[]                  @relation("ClientIntroducer")
  ownedProjects               Project[]                 @relation("ProjectOwner")
  goNogoDecisions             Project[]                 @relation("ProjectGoNogoBy")
  notifications               Notification[]            @relation("NotificationRecipient")
  projectsLed                 Project[]                 @relation("ProjectLeader")
  creativeTasksAssigned       CreativeTask[]            @relation("CreativeTaskAssignee")
  creativeTasksCd             CreativeTask[]            @relation("CreativeTaskAssignedBy")
  creativeTasksReviewed       CreativeTask[]            @relation("CreativeTaskReviewedBy")
  creativeTasksOrdered        CreativeTask[]            @relation("CreativeTaskOrderedBy")
  creativeRequests            CreativeRequest[]         @relation("CreativeRequestBy")
  departmentsLed              Department[]              @relation("DepartmentLead")
  creativeSquadsLed           CreativeSquad[]           @relation("CreativeSquadLead")
  creativeTaskApprovals       CreativeTaskApprover[]    @relation("CreativeTaskApproverStaff")

  @@map("staff")
}

model OptionSet {
  id   String @id @default(cuid())
  code String @unique // vd: industry, project_type, channel, fail_reason...
  name String

  items OptionItem[]

  @@map("option_set")
}

model OptionItem {
  id       String  @id @default(cuid())
  setId    String
  code     String
  labelVi  String
  labelEn  String?
  sort     Int     @default(0)
  isActive Boolean @default(true)

  set OptionSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  clientsAsIndustry           Client[]                  @relation("ClientIndustry")
  clientsAsStatus             Client[]                  @relation("ClientStatus")
  clientsAsClassification     Client[]                  @relation("ClientClassification")
  projectsAsType              Project[]                 @relation("ProjectType")
  projectsAsChannel           Project[]                 @relation("ProjectChannel")
  projectsAsFailReason        Project[]                 @relation("ProjectFailReason")
  projectsAsComplexity        Project[]                 @relation("ProjectComplexity")
  projectsAsStatus            Project[]                 @relation("ProjectStatus")
  creativeTasksAsType         CreativeTask[]            @relation("CreativeTaskType")
  creativeRatiosAsType        CreativeAllocationRatio[] @relation("CreativeRatioTaskType")

  @@unique([setId, code])
  @@map("option_item")
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String
  oldValue   String?
  newValue   String?
  action     String // CREATE | UPDATE | DELETE
  changedBy  String?
  changedAt  DateTime @default(now())
  reason     String?

  @@index([entityType, entityId])
  @@map("audit_log")
}

model Notification {
  id               String   @id @default(cuid())
  recipientStaffId String
  type             String // TEAM_ASSIGNMENT_NEEDED | COSTSHEET_REJECTED | BRAINSTORM_MEETING_INVITE | DEPARTMENT_ORDER_RECEIVED | ORDER_RESULT_RECEIVED | ORDER_DEADLINE_REMINDER | EXTERNAL_TIMELINE_UPDATED | TIMELINE_DEADLINE_REMINDER | CREATIVE_TASK_ASSIGNED | CREATIVE_TASK_NEEDS_APPROVAL | CREATIVE_TASK_DELIVERED | CREATIVE_TASK_REVISION | CREATIVE_TASK_DEADLINE_REMINDER | CREATIVE_TASK_ROUTED | ACCEPTANCE_SIGN_REMINDER | ADVANCE_REQUESTED | ADVANCE_DISBURSED | ADVANCE_SETTLED | AR_OVERDUE_REMINDER | CHAT_MESSAGE | CHAT_MENTION | REMINDER_DUE | POLL_CREATED | CTV_CONTRACTS_GENERATED | INVENTORY_TRANSFER_INCOMING | INVENTORY_RETURN_OVERDUE | SCHEDULE_CONFIRMED | SCHEDULE_UPDATED | PLANNING_STAGE_ASSIGNED | PLANNING_RESULT_SUBMITTED | PLANNING_REVISION_REQUESTED | PLANNING_FINAL_CONFIRMED | DEPT_TASK_ASSIGNED | DEPT_TASK_NEEDS_APPROVAL | DEPT_TASK_DELIVERED | DEPT_TASK_REVISION | DEPT_TASK_DEADLINE_REMINDER | INTERVIEW_REQUESTED | INTERVIEW_CONFIRMED | INTERVIEW_DECLINED
  title            String
  body             String?
  projectId        String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  recipient    Staff         @relation("NotificationRecipient", fields: [recipientStaffId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([recipientStaffId, isRead])
  @@map("notification")
}

model Client {
  id                String   @id @default(cuid())
  code              String   @unique // đúng 3 ký tự — vd LOF, DHG, CTL (validate ở app layer)
  name              String
  legalNameVi       String? // tên pháp lý đầy đủ tiếng Việt trên đăng ký kinh doanh — khác `name` (tên gọi/brand)
  legalNameEn       String?
  taxCode           String? // Mã số thuế (MST) — nullable: khách nhập từ danh sách cũ có thể chưa có, bổ sung trước khi ký hợp đồng (xem lib/client-profile.ts)
  industryId        String? // option_set "client_industry" — nullable cùng lý do taxCode
  statusId          String // Tình trạng: Tiềm năng|Active|Inactive — option_set "client_status"
  classificationId  String? // Phân loại vendor-list — option_set "client_classification" — nullable cùng lý do taxCode
  isNew             Boolean  @default(true)
  introducerId      String? // null = "Khác" (không phải nhân viên công ty) — liên quan tính commission, xem CommissionScheme
  /// CO/CE v3 — template báo giá mặc định của khách (mã trong registry CODE `lib/quote-templates.ts`,
  /// khuôn iso-catalog). Null = chưa gán → menu xuất hiện các template mẫu chung.
  quoteTemplateCode String?
  paymentTermDays   Int      @default(90)
  address           String?
  phone             String?
  email             String?
  bankAccount       String? // Tài khoản ngân hàng — nullable cùng lý do taxCode
  note              String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  industry       OptionItem?  @relation("ClientIndustry", fields: [industryId], references: [id])
  status         OptionItem   @relation("ClientStatus", fields: [statusId], references: [id])
  classification OptionItem?  @relation("ClientClassification", fields: [classificationId], references: [id])
  introducer     Staff?       @relation("ClientIntroducer", fields: [introducerId], references: [id])

  projects            Project[]

  @@map("client")
}

model Setting {
  id        String   @id @default(cuid())
  module    String
  key       String
  value     String // JSON hoặc số dạng text
  scope     String   @default("GLOBAL") // GLOBAL | TEAM | PROJECT
  scopeRef  String   @default("")
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([module, key, scope, scopeRef])
  @@map("setting")
}

model Project {
  id             String    @id @default(cuid())
  code           String    @unique // auto T{seq:03d}{CLIENT}{YY}A{team}
  name           String
  clientId       String
  ownerId        String? // PIC = Project Owner (Account cấp trên, duyệt External Timeline)
  leaderId       String? // Project Leader (nhân sự Account chạy timeline hằng ngày)
  statusId       String // option_set "project_status" — admin quản lý qua Settings, code cố định dùng cho state machine
  briefLinkUrl   String? // link brief nhận từ khách hàng — bắt buộc khi tạo dự án mới qua /bidding/new (validator);
  // nullable ở DB để chấp nhận dự án nhập từ hồ sơ cũ (import khách hàng) chưa có link brief số hoá
  projectTypeId  String?
  complexityId   String // option_set "complexity": simple|medium|complex — khách có concept hay TCM tự sáng tạo
  goNogoStatus   String? // PENDING | GO | NOGO (khi complexity != simple HOẶC khách mới)
  goNogoNote     String?
  goNogoById     String?
  goNogoAt       DateTime?
  budget         BigInt? // ngân sách khách (budget-down)
  channelId      String?
  scope          String?
  scale          String?
  venue          String?
  /// Ngày sự kiện — event 1 ngày chỉ nhập eventStartDate; nhiều ngày nhập cả hai. UTC-midnight
  /// (HANDOVER §4.3). Lên khối thông tin của báo giá BM02 ("Ngày bắt đầu/Ngày kết thúc").
  eventStartDate DateTime?
  eventEndDate   DateTime?
  activity       String?
  failReasonId   String? // bắt buộc khi status=Failed (enforce app layer)
  failReasonNote String?
  processingAt   DateTime? // mốc vào Processing — dùng tính reminder 7 ngày hoàn tất hợp đồng
  liquidationAt  DateTime? // mốc vào Liquidation — dùng tính reminder hàng tuần hồ sơ nghiệm thu
  finishedAt     DateTime? // mốc vào Finished — Creative có 7 ngày grace lưu về local server trước khi khóa task
  fiscalYear     Int
  /// Link thư mục hồ sơ dự án (SharePoint/Drive) — cột "Link Hồ sơ" của sheet ISO. KHÁC
  /// `briefLinkUrl` (link brief khách gửi): đây là thư mục CHỨA TOÀN BỘ hồ sơ dự án mà kiểm toán
  /// ISO mở ra xem. Trước 08/2026 app không có chỗ nào lưu link này.
  isoFolderUrl   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client      Client      @relation(fields: [clientId], references: [id])
  owner       Staff?      @relation("ProjectOwner", fields: [ownerId], references: [id])
  leader      Staff?      @relation("ProjectLeader", fields: [leaderId], references: [id])
  status      OptionItem  @relation("ProjectStatus", fields: [statusId], references: [id])
  projectType OptionItem? @relation("ProjectType", fields: [projectTypeId], references: [id])
  complexity  OptionItem  @relation("ProjectComplexity", fields: [complexityId], references: [id])
  channel     OptionItem? @relation("ProjectChannel", fields: [channelId], references: [id])
  failReason  OptionItem? @relation("ProjectFailReason", fields: [failReasonId], references: [id])
  goNogoBy    Staff?      @relation("ProjectGoNogoBy", fields: [goNogoById], references: [id])

  notifications         Notification[]
  creativeTasks         CreativeTask[]
  creativeRequests      CreativeRequest[]
  /// Kho v2 K4 — mốc mở KỲ CHIẾN DỊCH đang chạy (UTC-midnight). null = không có kỳ nào mở.
  /// CỜ TRẠNG THÁI, không phải lịch sử: lịch sử nằm ở sổ cái StockDocument (bất biến). Tự set khi
  /// thủ kho xác nhận xuất đồ tái sử dụng, tự xoá khi holding của dự án về 0.
  stockCampaignOpenedAt DateTime?
  /// LOF-V1 — nhóm chiến dịch (xem model ProjectGroup). null = dự án đứng riêng, là ĐA SỐ.


  @@map("project")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  staffId   String
  tokenHash String    @unique // sha256(token thô)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String? // null = do chính user bấm "Quên mật khẩu"; có giá trị = admin cấp lại hộ

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("password_reset_token")
}

model CreativeSquad {
  id          String   @id @default(cuid())
  code        String   @unique // CREATIVE | GRAPHIC_2D | MULTIMEDIA
  name        String
  leadStaffId String?
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead    Staff?         @relation("CreativeSquadLead", fields: [leadStaffId], references: [id])
  members Staff[]        @relation("StaffCreativeSquad")
  tasks   CreativeTask[]

  @@map("creative_squad")
}

model CreativeTaskApprover {
  id         String    @id @default(cuid())
  taskId     String
  staffId    String
  approvedAt DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  task  CreativeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staff Staff        @relation("CreativeTaskApproverStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([taskId, staffId])
  @@map("creative_task_approver")
}

model CreativeTask {
  id                     String    @id @default(cuid())
  projectId              String
  orderedById            String? // snapshot người ORDER (order.sentById ?? project.ownerId) — nơi trả thành phẩm
  sourceItemLabel        String? // nhãn ProjectOrderCreativeItem gốc (dedupe khi tự sinh)
  requestId              String? // yêu cầu sinh ra task này (null = CD tạo tay trên bảng)
  squadId                String? // CR-1: team nhỏ được điều phối — spawn gợi ý theo nhãn, CD sửa được
  taskTypeId             String? // option_set "creative_task_type" — CD chọn lúc giao
  title                  String
  detail                 String?
  status                 String    @default("UNASSIGNED") // UNASSIGNED | ASSIGNED | SUBMITTED | REVISION | DELIVERED | CANCELED
  assigneeId             String?
  assignedById           String? // CD giao việc
  assignedAt             DateTime?
  cdApprovalNotRequired  Boolean   @default(false) // tick "CD không cần duyệt" → GỬI đi thẳng cho người ORDER
  deadline               DateTime?
  deliverableLinkUrl     String? // link Drive/OneDrive
  hoursSpent             Float? // số giờ NV điền — bội số 0.25
  submittedAt            DateTime?
  revisionCount          Int       @default(0) // số lần CD trả lại — dùng đo chất lượng (duyệt lần 1?)
  reviewedById           String?
  reviewedAt             DateTime?
  deliveredAt            DateTime?
  deadlineReminderSentAt DateTime? // đã gửi notification nhắc quá hạn (idempotent — reset khi đổi deadline)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  squad      CreativeSquad?         @relation(fields: [squadId], references: [id], onDelete: SetNull)
  request    CreativeRequest?       @relation(fields: [requestId], references: [id], onDelete: SetNull)
  taskType   OptionItem?            @relation("CreativeTaskType", fields: [taskTypeId], references: [id])
  approvers  CreativeTaskApprover[]
  assignee   Staff?            @relation("CreativeTaskAssignee", fields: [assigneeId], references: [id])
  assignedBy Staff?            @relation("CreativeTaskAssignedBy", fields: [assignedById], references: [id])
  reviewedBy Staff?            @relation("CreativeTaskReviewedBy", fields: [reviewedById], references: [id])
  orderedBy  Staff?            @relation("CreativeTaskOrderedBy", fields: [orderedById], references: [id])

  // Backstop DB cho spawn idempotent — hai lượt gửi song song không tạo task trùng.
  // SQLite coi nhiều NULL là KHÁC nhau, nên task CD tạo tay (requestId null) không đụng ràng buộc này.
  @@unique([requestId, sourceItemLabel])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@map("creative_task")
}

model CreativeSalaryBudget {
  id                String   @id @default(cuid())
  positionTitle     String // khớp Staff.title của nhân sự CREATIVE
  periodCode        String
  monthlySalary     BigInt // VND/tháng cho MỘT người ở vị trí này
  headcountOverride Int? // null = suy ra live từ Staff active CREATIVE cùng title; set = chốt cứng cho kỳ đã đóng
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([positionTitle, periodCode])
  @@map("creative_salary_budget")
}

model CreativeAllocationRatio {
  id            String   @id @default(cuid())
  positionTitle String
  taskTypeId    String
  periodCode    String
  percent       Float    @default(0) // 0..100
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  taskType OptionItem @relation("CreativeRatioTaskType", fields: [taskTypeId], references: [id], onDelete: Cascade)

  @@unique([positionTitle, taskTypeId, periodCode])
  @@map("creative_allocation_ratio")
}

model PositionSalary {
  id             String   @id @default(cuid())
  positionTitle  String // khớp Staff.title
  departmentCode String // ACCOUNT | PLANNING | CREATIVE | OPE | PRO
  periodCode     String // "2026-M07" — kỳ áp dụng; resolve = dòng có periodCode lớn nhất ≤ kỳ đang tính
  monthlySalary  BigInt // VND/tháng full cho MỘT người ở vị trí này
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([positionTitle, departmentCode, periodCode])
  @@map("position_salary")
}

/// YÊU CẦU CREATIVE — đường NHẬN VIỆC của bản mini.
///
/// Ở bản TCM, task Creative sinh từ `ProjectOrder` mà Account gửi sang. Bản mini cắt Bidding nên
/// dựng bảng riêng, gọn hơn nhiều nhưng giữ đúng hai thứ đã trả giá để học được:
///  • `deadline` BẮT BUỘC và được CHÉP XUỐNG từng task lúc sinh — bản TCM từng bỏ trống cột hạn ở
///    bước này, hệ quả là bộ nhắc quá hạn không bao giờ chạy (0/5 task có hạn).
///  • Sinh task IDEMPOTENT theo `(requestId, sourceItemLabel)` — gửi lại/bấm hai lần không nhân đôi.
model CreativeRequest {
  id            String   @id @default(cuid())
  projectId     String
  requestedById String? // người đặt việc — nơi trả thành phẩm về
  briefLinkUrl  String?
  note          String?
  /// Hạn mong muốn cho cả gói yêu cầu. Từng task nhận đúng hạn này lúc sinh; CD điều phối lại được.
  deadline      DateTime
  createdAt     DateTime @default(now())

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy Staff?         @relation("CreativeRequestBy", fields: [requestedById], references: [id])
  tasks       CreativeTask[]

  @@index([projectId])
  @@map("creative_request")
}
