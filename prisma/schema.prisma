// ─────────────────────────────────────────────────────────
// NỀN TẢNG — Danh mục động (admin cấu hình) & Audit
// ─────────────────────────────────────────────────────────

model OptionSet {
  id   String @id @default(cuid())
  code String @unique // vd: industry, project_type, channel, fail_reason...
  name String

  items OptionItem[]

  @@map("option_set")
}

model OptionItem {
  id       String  @id @default(cuid())
  setId    String
  code     String
  labelVi  String
  labelEn  String?
  sort     Int     @default(0)
  isActive Boolean @default(true)

  set OptionSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  clientsAsIndustry           Client[]                  @relation("ClientIndustry")
  clientsAsStatus             Client[]                  @relation("ClientStatus")
  clientsAsClassification     Client[]                  @relation("ClientClassification")
  projectsAsType              Project[]                 @relation("ProjectType")
  projectsAsChannel           Project[]                 @relation("ProjectChannel")
  projectsAsFailReason        Project[]                 @relation("ProjectFailReason")
  projectsAsComplexity        Project[]                 @relation("ProjectComplexity")
  projectsAsStatus            Project[]                 @relation("ProjectStatus")
  templatesAsContractType     CostsheetTemplate[]       @relation("TemplateContractType")
  templatesAsProjectType      CostsheetTemplate[]       @relation("TemplateProjectType")
  timelineTemplatesAsType     TimelineTemplate[]        @relation("TimelineTemplateProjectType")
  timelineItemsAsStatus       TimelineItem[]            @relation("TimelineItemStatus")
  creativeTasksAsType         CreativeTask[]            @relation("CreativeTaskType")
  kbDocumentsAsCategory       KbDocument[]              @relation("KbDocumentCategory")
  creativeRatiosAsType        CreativeAllocationRatio[] @relation("CreativeRatioTaskType")
  inventoryItemsAsCategory    InventoryItem[]           @relation("InventoryItemCategory")
  shiftAssignmentsAsLeaveType ShiftAssignment[]         @relation("ShiftAssignmentLeaveType")
  mktPostsAsContentType       MktPost[]                 @relation("MktPostContentType")

  @@unique([setId, code])
  @@map("option_item")
}

/// Cơ sở tri thức TCM — thư viện hồ sơ dùng chung cho mọi phòng ban (General/Credentials/ISO/HS&E...).
/// Mỗi tài liệu là 1 tên + (file upload HOẶC link ngoài — đúng 1 trong 2). Danh mục = OptionItem
/// (setCode "kb_category"), admin tự thêm/sửa/xóa danh mục tại /settings/options/kb_category
/// mà không cần đổi code — cùng cơ chế danh mục động đã dùng toàn hệ thống.
model KbDocument {
  id           String   @id @default(cuid())
  categoryId   String
  title        String
  description  String?
  fileKey      String? // storageKey trong storage/kb-uploads (xem src/lib/kb-storage.ts) — null nếu là link
  fileMime     String?
  fileName     String? // tên file gốc lúc upload, dùng cho Content-Disposition khi tải về
  fileSize     Int? // bytes
  linkUrl      String? // URL ngoài — null nếu là file
  sort         Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   OptionItem @relation("KbDocumentCategory", fields: [categoryId], references: [id])
  uploadedBy Staff?     @relation("KbDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([categoryId, sort])
  @@map("kb_document")
}

/// Danh sách nhãn hàng — "ghi nhớ" tự động: user gõ brand mới ở form Khách hàng
/// thì hệ thống upsert-by-name, lần sau xuất hiện trong danh sách gợi ý/search.
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  clients Client[]

  @@map("brand")
}

/// Cấu hình thưởng giới thiệu khách hàng mới — CHỈ lưu tham số, chưa tính toán/chi trả.
/// Sẽ dùng khi xây module ⑥ KPI/Thưởng-Phạt: base = khi KH mới gửi brief đầu tiên,
/// contract = khi KH mới đó ký hợp đồng ĐẦU TIÊN (không tính hợp đồng tái ký).
model CommissionScheme {
  id                       String   @id @default(cuid())
  code                     String   @unique @default("default")
  baseCommissionAmount     Int // VND — thưởng khi KH mới gửi brief đầu tiên
  contractCommissionAmount Int // VND — thưởng khi KH mới ký hợp đồng đầu tiên
  note                     String?
  updatedBy                String?
  updatedAt                DateTime @updatedAt

  @@map("commission_scheme")
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String
  oldValue   String?
  newValue   String?
  action     String // CREATE | UPDATE | DELETE
  changedBy  String?
  changedAt  DateTime @default(now())
  reason     String?

  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Thông báo in-app — chưa có session thật nên KHÔNG lọc theo "current user" ở UI (xem
/// getCurrentStaffId TODO); mọi người xem /reminders đều thấy toàn bộ thông báo chưa đọc.
model Notification {
  id               String   @id @default(cuid())
  recipientStaffId String
  type             String // TEAM_ASSIGNMENT_NEEDED | COSTSHEET_REJECTED | BRAINSTORM_MEETING_INVITE | DEPARTMENT_ORDER_RECEIVED | ORDER_RESULT_RECEIVED | ORDER_DEADLINE_REMINDER | EXTERNAL_TIMELINE_UPDATED | TIMELINE_DEADLINE_REMINDER | CREATIVE_TASK_ASSIGNED | CREATIVE_TASK_NEEDS_APPROVAL | CREATIVE_TASK_DELIVERED | CREATIVE_TASK_REVISION | CREATIVE_TASK_DEADLINE_REMINDER | CREATIVE_TASK_ROUTED | ACCEPTANCE_SIGN_REMINDER | ADVANCE_REQUESTED | ADVANCE_DISBURSED | ADVANCE_SETTLED | AR_OVERDUE_REMINDER | CHAT_MESSAGE | CHAT_MENTION | REMINDER_DUE | POLL_CREATED | CTV_CONTRACTS_GENERATED | INVENTORY_TRANSFER_INCOMING | INVENTORY_RETURN_OVERDUE | SCHEDULE_CONFIRMED | SCHEDULE_UPDATED | PLANNING_STAGE_ASSIGNED | PLANNING_RESULT_SUBMITTED | PLANNING_REVISION_REQUESTED | PLANNING_FINAL_CONFIRMED | DEPT_TASK_ASSIGNED | DEPT_TASK_NEEDS_APPROVAL | DEPT_TASK_DELIVERED | DEPT_TASK_REVISION | DEPT_TASK_DEADLINE_REMINDER | INTERVIEW_REQUESTED | INTERVIEW_CONFIRMED | INTERVIEW_DECLINED
  title            String
  body             String?
  projectId        String?
  conversationId   String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  recipient    Staff         @relation("NotificationRecipient", fields: [recipientStaffId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([recipientStaffId, isRead])
  @@map("notification")
}

// ─────────────────────────────────────────────────────────
// MODULE ① — KHÁCH HÀNG
// ─────────────────────────────────────────────────────────

/// NHÓM KHÁCH HÀNG kiểu "family" — vd AEON gom 4 pháp nhân AHD/AHL/ALB/AHP.
///
/// CHỈ là nhãn gom + chỗ neo Knowledge Base dùng chung. Hợp đồng, hoá đơn, công nợ, mã lô kho
/// và mã dự án VẪN theo TỪNG pháp nhân (Client) như trước — cố ý không làm cây cha–con vì
/// công ty mẹ không đứng tên ký thay con ở nghiệp vụ thật.
///
/// ⚠ `code` ở đây 2–10 ký tự và KHÔNG tham gia bất kỳ mã sinh tự động nào. Đừng nhầm với
/// `Client.code` 3 ký tự — mã đó nằm trong mã lô kho (lib/inventory-lot.ts) và mã dự án
/// (lib/bidding.ts), đổi là hỏng dữ liệu cũ.
model ClientGroup {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  note      String?
  isActive  Boolean  @default(true) // tắt = ẩn khỏi ô chọn khi gán mới; member cũ giữ nguyên nhóm
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
  kbSpace ClientKbSpace?

  @@map("client_group")
}

model Client {
  id                String   @id @default(cuid())
  code              String   @unique // đúng 3 ký tự — vd LOF, DHG, CTL (validate ở app layer)
  name              String
  legalNameVi       String? // tên pháp lý đầy đủ tiếng Việt trên đăng ký kinh doanh — khác `name` (tên gọi/brand)
  legalNameEn       String?
  taxCode           String? // Mã số thuế (MST) — nullable: khách nhập từ danh sách cũ có thể chưa có, bổ sung trước khi ký hợp đồng (xem lib/client-profile.ts)
  brandId           String
  industryId        String? // option_set "client_industry" — nullable cùng lý do taxCode
  statusId          String // Tình trạng: Tiềm năng|Active|Inactive — option_set "client_status"
  classificationId  String? // Phân loại vendor-list — option_set "client_classification" — nullable cùng lý do taxCode
  isNew             Boolean  @default(true)
  introducerId      String? // null = "Khác" (không phải nhân viên công ty) — liên quan tính commission, xem CommissionScheme
  ownerTeamId       String? // team đang phụ trách — null = khách cấp BGĐ/chưa giao team ACC cụ thể (mirror Project.ownerTeamId)
  groupId           String? // ClientGroup — null = khách lẻ. Chỉ để gom nhóm + neo KB dùng chung.
  /// CO/CE v3 — template báo giá mặc định của khách (mã trong registry CODE `lib/quote-templates.ts`,
  /// khuôn iso-catalog). Null = chưa gán → menu xuất hiện các template mẫu chung.
  quoteTemplateCode String?
  paymentTermDays   Int      @default(90)
  address           String?
  phone             String?
  email             String?
  bankAccount       String? // Tài khoản ngân hàng — nullable cùng lý do taxCode
  note              String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  brand          Brand        @relation(fields: [brandId], references: [id])
  industry       OptionItem?  @relation("ClientIndustry", fields: [industryId], references: [id])
  status         OptionItem   @relation("ClientStatus", fields: [statusId], references: [id])
  classification OptionItem?  @relation("ClientClassification", fields: [classificationId], references: [id])
  introducer     Staff?       @relation("ClientIntroducer", fields: [introducerId], references: [id])
  ownerTeam      Team?        @relation("ClientOwnerTeam", fields: [ownerTeamId], references: [id])
  group          ClientGroup? @relation(fields: [groupId], references: [id])

  contacts            Contact[]
  transfers           ClientTransfer[]
  projects            Project[]
  careNotes           CareNote[]
  invoices            ClientInvoice[]
  inventoryItemsOwned InventoryItem[]  @relation("InventoryItemOwnerClient")
  kbSpace             ClientKbSpace?

  @@index([groupId])
  @@map("client")
}

/// Thông tin chăm sóc khách hàng — mỗi lần Account PIC gặp/gọi/nhắn khách thì log 1 dòng.
/// lastCareAt của khách = MAX(createdAt) các dòng này (tính động, không lưu trùng).
model CareNote {
  id        String   @id @default(cuid())
  clientId  String
  note      String
  staffId   String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff  Staff? @relation("CareNoteStaff", fields: [staffId], references: [id])

  @@index([clientId, createdAt])
  @@map("care_note")
}

/// PIC phía khách hàng — mỗi Client có tối thiểu 1, tối đa 10 (enforce ở app layer).
model Contact {
  id        String    @id @default(cuid())
  clientId  String
  name      String
  title     String? // nullable: danh sách nhập cũ nhiều dòng thiếu chức danh — vẫn muốn lưu được tên PIC
  phone     String?
  email     String?
  birthday  DateTime?
  address   String?
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  guestInvites GuestInvite[]

  @@map("contact")
}

/// Chuyển khách hàng giữa 2 team Account — khác với Handover (chuyển dự án, ở module ③)
model ClientTransfer {
  id              String   @id @default(cuid())
  clientId        String
  fromTeamId      String
  toTeamId        String
  reason          String
  transferredById String
  approvedById    String?
  transferredAt   DateTime @default(now())

  client        Client @relation(fields: [clientId], references: [id])
  fromTeam      Team   @relation("TransferFromTeam", fields: [fromTeamId], references: [id])
  toTeam        Team   @relation("TransferToTeam", fields: [toTeamId], references: [id])
  transferredBy Staff  @relation("TransferRequestedBy", fields: [transferredById], references: [id])
  approvedBy    Staff? @relation("TransferApprovedBy", fields: [approvedById], references: [id])

  @@map("client_transfer")
}

// ─────────────────────────────────────────────────────────
// NỀN TẢNG (bổ sung khi module ② cần) — Vendor · Setting · CO/CE template
// ─────────────────────────────────────────────────────────

/// Nhà cung cấp — master dùng chung; cost_line trỏ vào để truy nguồn giá mua.
model Vendor {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String // PCC | PRO | OPE | OTHER
  contact   String?
  phone     String?
  email     String?
  taxCode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costLines        CostLine[]
  financeCostLines FinanceCostLine[]
  advancesReceived Advance[]         @relation("AdvanceRecipientVendor")
  vendorPayments   VendorPayment[]
  purchaseOrders   PurchaseOrder[]

  @@map("vendor")
}

/// Tham số hệ thống theo module/scope — vd min_margin_pct, auto_approve_threshold.
/// scopeRef "" = GLOBAL; theo team/project thì lưu id vào scopeRef.
model Setting {
  id        String   @id @default(cuid())
  module    String
  key       String
  value     String // JSON hoặc số dạng text
  scope     String   @default("GLOBAL") // GLOBAL | TEAM | PROJECT
  scopeRef  String   @default("")
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([module, key, scope, scopeRef])
  @@map("setting")
}

/// Form CO/CE mẫu — mỗi Nhóm dự án (project_type) nên có 1 mẫu chuẩn; contractTypeId
/// là lọc bổ sung (tùy chọn). Gồm nhiều hạng mục (section), mỗi hạng mục nhiều dòng.
model CostsheetTemplate {
  id             String   @id @default(cuid())
  name           String
  projectTypeId  String?
  contractTypeId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectType            OptionItem?                @relation("TemplateProjectType", fields: [projectTypeId], references: [id])
  contractType           OptionItem?                @relation("TemplateContractType", fields: [contractTypeId], references: [id])
  sections               CostsheetTemplateSection[]
  costSheets             CostSheet[]
  costsheetTemplateLines CostsheetTemplateLine[]

  @@map("costsheet_template")
}

/// Hạng mục (section) trong 1 mẫu CO/CE — vd "Địa điểm", "Âm thanh ánh sáng"...
/// isProxy=true đánh dấu hạng mục đặc biệt "Chi hộ/Thu hộ Khách hàng" (có phí dịch vụ riêng).
model CostsheetTemplateSection {
  id           String  @id @default(cuid())
  templateId   String
  code         String
  icon         String?
  nameVi       String
  nameEn       String?
  colorSlot    String? // token màu badge, vd "brand"|"success"|"warning"...
  sort         Int     @default(0)
  isProxy      Boolean @default(false)
  proxyFeeType String? // PCT | FIXED — chỉ dùng khi isProxy
  proxyFeeVal  Float? // % hoặc số tiền cố định (VND) tùy proxyFeeType

  template CostsheetTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  lines    CostsheetTemplateLine[]

  @@map("costsheet_template_section")
}

model CostsheetTemplateLine {
  id               String  @id @default(cuid())
  sectionId        String // → section.templateId cho biết mẫu nào (không cần FK trực tiếp tới template)
  lineType         String  @default("QTY_PRICE") // QTY_PRICE | FIXED | PERCENT_OF_TOTAL
  itemName         String
  defaultSpecs     String?
  defaultQty       Float   @default(1)
  defaultUnit      String?
  defaultUnitPrice BigInt  @default(0) // dùng khi lineType=QTY_PRICE
  fixedAmount      BigInt? // dùng khi lineType=FIXED
  percentVal       Float? // dùng khi lineType=PERCENT_OF_TOTAL
  isLocked         Boolean @default(false) // không cho make-up
  maxMarkupPct     Float? // trần make-up của line (null = không giới hạn)
  sort             Int     @default(0)

  section             CostsheetTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  costsheetTemplate   CostsheetTemplate?       @relation(fields: [costsheetTemplateId], references: [id])
  costsheetTemplateId String?

  @@map("costsheet_template_line")
}

// ─────────────────────────────────────────────────────────
// MODULE ② — BIDDING & CONTRACT
// ─────────────────────────────────────────────────────────

/// Dự án — BẢNG TRUNG TÂM, khai sinh ở bước tiếp nhận (status=Bidding), xuyên suốt bid→exec→finish.
model Project {
  id             String    @id @default(cuid())
  code           String    @unique // auto T{seq:03d}{CLIENT}{YY}A{team}
  name           String
  clientId       String
  ownerTeamId    String? // null = "Đợi BGĐ giao team Account" — chưa xác định team phụ trách
  ownerId        String? // PIC = Project Owner (Account cấp trên, duyệt External Timeline)
  leaderId       String? // Project Leader (nhân sự Account chạy timeline hằng ngày)
  statusId       String // option_set "project_status" — admin quản lý qua Settings, code cố định dùng cho state machine
  briefLinkUrl   String? // link brief nhận từ khách hàng — bắt buộc khi tạo dự án mới qua /bidding/new (validator);
  // nullable ở DB để chấp nhận dự án nhập từ hồ sơ cũ (import khách hàng) chưa có link brief số hoá
  projectTypeId  String?
  complexityId   String // option_set "complexity": simple|medium|complex — khách có concept hay TCM tự sáng tạo
  goNogoStatus   String? // PENDING | GO | NOGO (khi complexity != simple HOẶC khách mới)
  goNogoNote     String?
  goNogoById     String?
  goNogoAt       DateTime?
  budget         BigInt? // ngân sách khách (budget-down)
  channelId      String?
  scope          String?
  scale          String?
  venue          String?
  /// Ngày sự kiện — event 1 ngày chỉ nhập eventStartDate; nhiều ngày nhập cả hai. UTC-midnight
  /// (HANDOVER §4.3). Lên khối thông tin của báo giá BM02 ("Ngày bắt đầu/Ngày kết thúc").
  eventStartDate DateTime?
  eventEndDate   DateTime?
  activity       String?
  failReasonId   String? // bắt buộc khi status=Failed (enforce app layer)
  failReasonNote String?
  processingAt   DateTime? // mốc vào Processing — dùng tính reminder 7 ngày hoàn tất hợp đồng
  liquidationAt  DateTime? // mốc vào Liquidation — dùng tính reminder hàng tuần hồ sơ nghiệm thu
  finishedAt     DateTime? // mốc vào Finished — Creative có 7 ngày grace lưu về local server trước khi khóa task
  fiscalYear     Int
  /// Link thư mục hồ sơ dự án (SharePoint/Drive) — cột "Link Hồ sơ" của sheet ISO. KHÁC
  /// `briefLinkUrl` (link brief khách gửi): đây là thư mục CHỨA TOÀN BỘ hồ sơ dự án mà kiểm toán
  /// ISO mở ra xem. Trước 08/2026 app không có chỗ nào lưu link này.
  isoFolderUrl   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client      Client      @relation(fields: [clientId], references: [id])
  ownerTeam   Team?       @relation("ProjectOwnerTeam", fields: [ownerTeamId], references: [id])
  owner       Staff?      @relation("ProjectOwner", fields: [ownerId], references: [id])
  leader      Staff?      @relation("ProjectLeader", fields: [leaderId], references: [id])
  status      OptionItem  @relation("ProjectStatus", fields: [statusId], references: [id])
  projectType OptionItem? @relation("ProjectType", fields: [projectTypeId], references: [id])
  complexity  OptionItem  @relation("ProjectComplexity", fields: [complexityId], references: [id])
  channel     OptionItem? @relation("ProjectChannel", fields: [channelId], references: [id])
  failReason  OptionItem? @relation("ProjectFailReason", fields: [failReasonId], references: [id])
  goNogoBy    Staff?      @relation("ProjectGoNogoBy", fields: [goNogoById], references: [id])

  biddingRounds         BiddingRound[]
  costSheets            CostSheet[]
  contract              Contract?
  notifications         Notification[]
  orders                ProjectOrder[]
  members               ProjectMember[]
  timelineItems         TimelineItem[]
  staffing              ProjectStaffing[]
  guestInvites          GuestInvite[]
  creativeTasks         CreativeTask[]
  departmentTasks       DepartmentTask[]
  financeCostLines      FinanceCostLine[]
  advances              Advance[]
  vendorPayments        VendorPayment[]
  clientInvoices        ClientInvoice[]
  ctvBatches            CtvBatch[]
  collectionMilestones  CollectionMilestone[]
  purchaseOrders        PurchaseOrder[]
  /// Kho v2 K4 — mốc mở KỲ CHIẾN DỊCH đang chạy (UTC-midnight). null = không có kỳ nào mở.
  /// CỜ TRẠNG THÁI, không phải lịch sử: lịch sử nằm ở sổ cái StockDocument (bất biến). Tự set khi
  /// thủ kho xác nhận xuất đồ tái sử dụng, tự xoá khi holding của dự án về 0.
  stockCampaignOpenedAt DateTime?
  /// LOF-V1 — nhóm chiến dịch (xem model ProjectGroup). null = dự án đứng riêng, là ĐA SỐ.
  groupId               String?

  stockDocuments      StockDocument[]       @relation("StockDocProject")
  stockDocumentsFrom  StockDocument[]       @relation("StockDocFromProject")
  stockRequests       StockRequest[]
  inventoryHoldings   ProjectHolding[]
  inventoryItemsBound InventoryItem[]       @relation("InventoryItemBoundProject")
  planningJobs        PlanningJob[]
  planningLoans       PlanningLoanRequest[]
  files               ProjectFile[]
  isoDocs             ProjectIsoDoc[]
  mktPosts            MktPost[]
  group               ProjectGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([ownerTeamId, statusId])
  @@map("project")
}

/// LOF-V1 — NHÓM CHIẾN DỊCH: gom nhiều dự án của cùng một chiến dịch nhiều giai đoạn (vd KUN
/// đường trượt 10 tỉnh = phase 1 (5 tỉnh) + phase 2 (5 tỉnh)) để xem tổng CO/CE, hoá đơn, công nợ
/// một chỗ. Trước đây "phase" chỉ nằm trong `Project.name` nên máy không nối được hai dự án.
///
/// Khuôn theo ClientGroup (KH-H1): chỉ bật/tắt, KHÔNG có đường xoá — xoá nhóm đang được dự án trỏ
/// vào là mất dấu vết gom. Nhóm THUẦN NHÃN GOM: mỗi dự án vẫn giữ nguyên CostSheet, Contract, hoá
/// đơn của riêng nó; trang nhóm chỉ ĐỌC và CỘNG, không lưu tổng nào (bất biến "không tạo hệ thống
/// tổng tiền song song", HANDOVER mục 6).
///
/// ⚠ `code` KHÔNG đi vào bất kỳ mã sinh nào (khác `Client.code` 3 ký tự — mã đó nằm trong mã lô
/// kho và mã dự án). Đổi code nhóm không hỏng dữ liệu cũ.
model ProjectGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  note        String?
  /// CE HỢP ĐỒNG KHUNG khách đã chốt cho CẢ chiến dịch (chưa VAT, sau phí agency) — nhập tay từ
  /// hợp đồng. SỐ THAM CHIẾU thuần (tiền lệ `Project.budget`): trang nhóm so nó với Σ ceTotal của
  /// các phase để lộ ra phát sinh/giảm trừ; không cộng vào bất kỳ báo cáo tiền nào. Ca thật: KUN
  /// khung 13.981.715.611 vs Σ phase sau nghiệm thu phase 1 = +286.848.222 phát sinh được duyệt.
  frameworkCe BigInt?
  isActive    Boolean  @default(true) // tắt = ẩn khỏi ô chọn khi gán mới; dự án cũ giữ nguyên nhóm
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@map("project_group")
}

/// SỔ ĐĂNG KÝ HỒ SƠ ISO — chỉ giữ phần CON NGƯỜI làm.
///
/// 25 loại hồ sơ ISO khai ở src/lib/iso-catalog.ts. Trong đó 14 loại app TỰ CHẤM được từ dữ liệu
/// sẵn có (Proposal FINAL, CO/CE, timeline, hợp đồng…) — phần đó KHÔNG có dòng nào ở đây, vì tính
/// lúc đọc mới không nói dối khi dữ liệu gốc đổi (xem doc src/lib/iso-report.ts).
///
/// Bảng này chỉ sinh dòng khi PIC: đính file, dán link, hoặc đánh "không áp dụng".
model ProjectIsoDoc {
  id            String   @id @default(cuid())
  projectId     String
  /// Mã trong ISO_DOCS (ISO-01…ISO-25) — BẤT BIẾN, chốt bằng isIsoDocCode() ở mọi đường ghi.
  docCode       String
  /// PRESENT = đã có bằng chứng đính kèm · NA = không áp dụng cho dự án này (BẮT BUỘC có naReason).
  status        String
  linkUrl       String?
  projectFileId String?
  /// ISO đòi giải trình vì sao thiếu — chính là cột "Ghi chú về dự án" của sheet HS ISO.
  naReason      String?
  note          String?
  updatedById   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectFile ProjectFile? @relation(fields: [projectFileId], references: [id], onDelete: SetNull)
  updatedBy   Staff?       @relation("ProjectIsoDocUpdatedBy", fields: [updatedById], references: [id])

  @@unique([projectId, docCode])
  @@index([projectId])
  @@map("project_iso_doc")
}

/// Thư viện file đính kèm CẤP DỰ ÁN — "file mời thầu", tài liệu khách gửi... Nguồn duy nhất mà các
/// công cụ AI (Ý tưởng/Content/Canva brief) tự động kéo theo khi người dùng chọn 1 dự án, để model
/// đọc được nội dung thật thay vì chỉ tên dự án. Upload 1 lần tại bất kỳ công cụ AI nào có gắn dự án
/// đó → dùng lại cho mọi lần chạy AI sau trên cùng dự án (không phải đính kèm ephemeral từng lần).
/// Lưu trên đĩa qua src/lib/ai-file-storage.ts (cùng pattern storage/kb-uploads, storage/chat-uploads).
model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  label        String? // "Mời thầu" | "Tài liệu khách gửi" | tự do — người upload tự ghi, không bắt buộc
  fileKey      String // storageKey trong storage/ai-uploads/YYYY/MM/...
  fileMime     String
  fileName     String // tên file gốc, dùng cho Content-Disposition + hiển thị UI
  fileSize     Int // bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy Staff?          @relation("ProjectFileUploadedBy", fields: [uploadedById], references: [id])
  isoDocs    ProjectIsoDoc[]

  @@index([projectId])
  @@map("project_file")
}

/// Operations (OPE) — 1 đợt thuê nhân sự ngoài (CTV) của 1 dự án, nhập từ file Excel BM08/QT.TCM.16
/// ("Bảng thanh toán tiền thuê ngoài"). Lưu phẳng theo dự án — KHÔNG có hồ sơ CTV tái sử dụng chéo
/// dự án (đã chốt với chủ dự án); mỗi đợt import ghi đè toàn bộ dòng của chính nó (replace-all, như
/// saveCostSheet), không đụng đợt khác.
model CtvBatch {
  id                       String   @id @default(cuid())
  projectId                String
  name                     String? // vd "BM08 — đợt 1"
  programFrom              String? // "Chương trình từ ngày" — giữ string, chỉ để in lại, không dùng tính toán
  programTo                String? // "Đến ngày"
  teamLeader               String? // "Nhóm trưởng"
  workLocation             String? // "Địa điểm làm việc" — điền vào {DiaDiemLamViec} của biên bản
  sourceFileKey            String? // storageKey (lib/chat-storage.ts) của file Excel gốc đã import, để tải lại
  /// Dòng CO/CE MẶC ĐỊNH của cả đợt — dòng nào không tự gán riêng thì kế thừa dòng này. Đặt ở cấp
  /// đợt để sống sót qua import Excel replace-all (import xoá sạch gán theo từng dòng).
  /// SetNull: dòng CO biến mất ở bản CO/CE mới KHÔNG được kéo đổ dữ liệu đợt CTV.
  defaultFinanceCostLineId String?
  createdById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  project                Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy              Staff?           @relation(fields: [createdById], references: [id])
  rows                   CtvContract[]
  defaultFinanceCostLine FinanceCostLine? @relation("CtvBatchDefaultLine", fields: [defaultFinanceCostLineId], references: [id], onDelete: SetNull)
  /// Phiếu chi NCC sinh từ đợt này ("Đề xuất thanh toán") — kênh trả CTV thật của TCM là kế toán
  /// chuyển khoản theo BM08, nên tiền đi qua VendorPayment để ăn trần dòng CO + vào cashflow như
  /// mọi khoản chi khác (quyết định CEO 27/07/2026 — không dựng hệ thanh toán song song).
  vendorPayments         VendorPayment[]

  @@index([projectId])
  @@map("ctv_batch")
}

/// 1 dòng = 1 dịch vụ thuê ngoài = 1 biên bản (nguyên tắc từ file Excel gốc: "Mỗi dịch vụ được làm
/// một biên bản thỏa thuận"). Đa số field giữ String để in lại "y nguyên" những gì nhập ở hiện
/// trường (không validate/tính lại) — theo đúng quyết định "lấy nguyên từ Excel" cho Thuế TNCN/Thực
/// nhận. Tiền vẫn dùng BigInt (quy ước chung toàn app) dù không tính toán, để cộng dòng Tổng cộng
/// trên lưới an toàn (không lệch số thực khi hiển thị).
model CtvContract {
  id                String    @id @default(cuid())
  batchId           String
  sort              Int       @default(0) // STT trên lưới
  fullName          String
  gender            String?
  dateOfBirth       String? // giữ string (nhập tay hiện trường, không chắc đúng định dạng ngày)
  nationality       String?
  idNumber          String? // Số CCCD/Passport
  idIssueDate       String?
  idIssuePlace      String?
  permanentAddress  String?
  taxCode           String? // Mã số thuế cá nhân (TNCN) — KHÔNG phải MST công ty
  bankAccountNo     String?
  bankName          String?
  bankBranch        String?
  phone             String?
  eventName         String? // "Tên event" — không có chỗ in trong biên bản, chỉ lưu tham khảo
  executionDate     String? // Ngày thực hiện
  acceptanceDate    String? // Ngày nghiệm thu
  executionLocation String? // "Địa điểm thực hiện" (khác workLocation của batch = "Địa điểm làm việc")
  workItem          String? // Hạng mục công việc
  unit              String? // ĐVT — free text (Gói/Ngày...), không ràng buộc option set
  quantity          Float?
  unitPrice         BigInt?
  amount            BigInt? // Thành tiền — lấy nguyên từ Excel, không tính lại
  grossNet          String? // "G" | "N" | giá trị khác nếu người nhập ghi khác
  pitTax            BigInt? // Thuế TNCN — lấy nguyên từ Excel
  netReceived       BigInt? // Thực nhận — lấy nguyên từ Excel
  note              String?
  generatedFileKey  String? // storageKey (.docx đã điền) — set sau khi bấm "Tạo hợp đồng CTV"
  generatedAt       DateTime?
  /// Dòng CO/CE mà chi phí CTV này thuộc về — để đối chiếu Kế hoạch ↔ Đã ký theo TỪNG dòng CO
  /// (một đợt roadshow gồm MC/PG/Sup/Helper/Bảo vệ là 5-6 dòng CO đơn giá khác nhau, gán cả đợt
  /// vào 1 dòng thì con số chênh lệch vô nghĩa). Trống = kế thừa defaultFinanceCostLineId của đợt.
  /// SetNull: dòng CO biến mất ở bản mới KHÔNG được xoá biên bản CTV đã ký (chứng từ pháp lý).
  financeCostLineId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batch           CtvBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  financeCostLine FinanceCostLine? @relation("CtvRowLine", fields: [financeCostLineId], references: [id], onDelete: SetNull)

  @@index([batchId, sort])
  @@index([financeCostLineId])
  @@map("ctv_contract")
}

/// Order Account gửi các bộ phận nội bộ (trước khi dựng CO/CE) — Brainstorm (đặt lịch họp, không có
/// Accept) hoặc 5 phòng ban Planning/Creative/Purchasing(PCC)/Operation(OPE)/Production(PRO) (có Accept).
model ProjectOrder {
  id                     String    @id @default(cuid())
  projectId              String
  department             String // BRAINSTORM | PLANNING | CREATIVE | PCC | OPE | PRO | HR | IT
  origin                 String    @default("MANUAL") // MANUAL (tick tay ở Bidding) | TIMELINE (tự gom từ PIC Master Timeline)
  isDraft                Boolean   @default(false) // ORDER nháp gom từ Timeline — Leader duyệt/sửa rồi mới dispatch (gửi thật)
  status                 String    @default("SENT") // SENT | ACCEPTED | DONE (BRAINSTORM luôn dừng ở SENT)
  briefLinkUrl           String? // snapshot project.briefLinkUrl lúc gửi
  extraBriefInfo         String?
  outputRequest          String? // PLANNING|PCC|OPE|PRO — Creative dùng ProjectOrderCreativeItem thay vì field này
  desiredTimeline        DateTime?
  meetingAt              DateTime? // chỉ BRAINSTORM
  meetingLocation        String? // chỉ BRAINSTORM
  meetingFormat          String? // ONLINE | OFFLINE — chỉ BRAINSTORM
  sentAt                 DateTime  @default(now())
  sentById               String?
  acceptedAt             DateTime?
  acceptedById           String?
  resultLinkUrl          String? // link Drive/OneDrive chứa kết quả — bộ phận gửi lại khi hoàn thành
  resultSentAt           DateTime?
  resultSentById         String?
  deadlineReminderSentAt DateTime? // đã gửi notification nhắc quá hạn (idempotent — chỉ gửi 1 lần)

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sentBy       Staff?  @relation("ProjectOrderSentBy", fields: [sentById], references: [id])
  acceptedBy   Staff?  @relation("ProjectOrderAcceptedBy", fields: [acceptedById], references: [id])
  resultSentBy Staff?  @relation("ProjectOrderResultSentBy", fields: [resultSentById], references: [id])

  creativeItems   ProjectOrderCreativeItem[]
  items           ProjectOrderItem[]
  attendees       ProjectOrderAttendee[]
  creativeTasks   CreativeTask[]
  departmentTasks DepartmentTask[]
  planningJob     PlanningJob?

  @@unique([projectId, department])
  @@map("project_order")
}

/// Checklist output riêng cho Order Creative — chỉ tạo dòng cho mục nào được tick.
model ProjectOrderCreativeItem {
  id      String  @id @default(cuid())
  orderId String
  label   String // KEY_VISUAL | DESIGN_2D | DESIGN_3D | SET_DESIGN | VIDEO | OTHER
  detail  String?

  order ProjectOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("project_order_creative_item")
}

/// Dòng hạng mục của 1 ORDER — tổng quát hóa cho mọi bộ phận. Tự sinh từ Master Timeline
/// (sourceTimelineItemId = provenance, idempotent) hoặc thêm tay. Leader sửa detail + set
/// desiredReceiptAt từng dòng trước khi dispatch. Creative đọc bảng này để spawn CreativeTask.
model ProjectOrderItem {
  id                   String    @id @default(cuid())
  orderId              String
  sourceTimelineItemId String? // TimelineItem gốc (idempotent key khi sync) — null nếu thêm tay
  label                String
  detail               String?
  desiredReceiptAt     DateTime? // timeline mong muốn nhận kết quả (Leader set từng dòng)
  status               String    @default("PENDING") // PENDING | DONE
  sort                 Int       @default(0)

  order              ProjectOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceTimelineItem TimelineItem?    @relation("OrderItemSource", fields: [sourceTimelineItemId], references: [id], onDelete: SetNull)
  creativeTasks      CreativeTask[] // task Creative sinh từ dòng này (nếu Order CREATIVE) — dùng để đẩy status→DONE khi task DELIVERED
  departmentTasks    DepartmentTask[] // task bộ phận (PLANNING|PCC|OPE|PRO) sinh từ dòng này — đẩy status→DONE khi task DELIVERED

  @@index([orderId, sort])
  @@map("project_order_item")
}

/// Người được mời họp Brainstorm.
model ProjectOrderAttendee {
  id      String @id @default(cuid())
  orderId String
  staffId String

  order ProjectOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff Staff        @relation(fields: [staffId], references: [id])

  @@unique([orderId, staffId])
  @@map("project_order_attendee")
}

/// Mỗi vòng deal giá (Round 2-5) — log đầy đủ để đo chi phí theo đuổi & phân tích win/loss.
model BiddingRound {
  id             String   @id @default(cuid())
  projectId      String
  roundNo        Int
  roundDate      DateTime @default(now())
  clientFeedback String?
  revisedCe      BigInt?
  outcome        String   @default("ongoing") // ongoing | accepted | rejected
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy Staff?  @relation("BiddingRoundCreatedBy", fields: [createdById], references: [id])

  @@map("bidding_round")
}

/// CECO — module ② chỉ tạo bản CTRACT (lúc bid/ký); bản LIQUID sinh ở module ④ lúc nghiệm thu.
model CostSheet {
  id                          String    @id @default(cuid())
  projectId                   String
  version                     String    @default("CTRACT") // CTRACT | LIQUID
  scenario                    String    @default("COST_UP") // COST_UP | BUDGET_DOWN
  templateId                  String?
  ceTotal                     BigInt    @default(0)
  coTotal                     BigInt    @default(0) // = directCo + percentLinesTotal + mgmtFeeAmt + contingencyAmt (tính app-side)
  chiHo                       BigInt    @default(0) // hạng mục Chi hộ (proxySubtotal + phí dịch vụ) — ngoài margin
  vatPct                      Float     @default(0)
  /// % PHÍ AGENCY trên báo giá gửi khách (form BM02: Σ dòng dịch vụ → +phí agency → +VAT = tổng
  /// cuối). CHỈ dùng để TRÌNH BÀY bản xuất — một phần của make-up từ CO sang CE mà không đụng
  /// từng dòng; KHÔNG tham gia coTotal/ceTotal/margin (bất biến #3: ceTotal vẫn là số đã duyệt,
  /// bản xuất chỉ suy ngược Σ dòng = ceTotal ÷ (1+VAT) ÷ (1+phí)).
  agencyFeePct                Float     @default(10)
  mgmtFeePct                  Float     @default(0) // Phí quản lý dự án % — áp trên direct CO
  contingencyPct              Float     @default(0) // Dự phòng phát sinh % — áp trên direct CO
  discountPct                 Float     @default(0) // Chiết khấu tổng % — chỉ dùng khi suy ra CE gợi ý từ CO
  minMarginPct                Float     @default(31)
  marginOverrideById          String?
  marginOverrideNote          String?
  approvedById                String?
  approvedAt                  DateTime?
  rejectedById                String?
  rejectedNote                String?
  rejectedAt                  DateTime?
  // Bản CO/CE cuối đã "Chuyển sang Nghiệm thu" từ Project workspace — trỏ tới 1 CostSheetRevision cụ thể
  // (không phải luôn = bản sống mới nhất, vì sau khi chuyển vẫn có thể sửa tiếp CO/CE rồi chuyển lại).
  sentToLiquidationRevisionId String?
  sentToLiquidationAt         DateTime?
  sentToLiquidationById       String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  project                   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template                  CostsheetTemplate?  @relation(fields: [templateId], references: [id])
  marginOverrideBy          Staff?              @relation("CostSheetOverrideBy", fields: [marginOverrideById], references: [id])
  approvedBy                Staff?              @relation("CostSheetApprovedBy", fields: [approvedById], references: [id])
  rejectedBy                Staff?              @relation("CostSheetRejectedBy", fields: [rejectedById], references: [id])
  sentToLiquidationRevision CostSheetRevision?  @relation("CostSheetLiquidationRevision", fields: [sentToLiquidationRevisionId], references: [id])
  sentToLiquidationBy       Staff?              @relation("CostSheetSentToLiquidationBy", fields: [sentToLiquidationById], references: [id])
  sections                  CostSheetSection[]
  costLines                 CostLine[]
  revisions                 CostSheetRevision[]

  @@map("cost_sheet")
}

/// Bản snapshot bất biến mỗi lần lưu CO/CE — để tracking version cuối (realtime = sheet sống)
/// + so sánh 2 phiên bản (item nào thêm/xóa/sửa, chênh bao nhiêu tiền). isBaseline = bản hợp đồng gốc.
/// snapshotJson chứa toàn bộ sections+lines lúc lưu (xem src/lib/costsheet-diff.ts để so sánh).
model CostSheetRevision {
  id            String   @id @default(cuid())
  costSheetId   String
  revNo         Int // tăng dần theo costSheet
  isBaseline    Boolean  @default(false) // đánh dấu bản gốc (thường tạo lúc vào Processing)
  ceTotal       BigInt   @default(0)
  coTotal       BigInt   @default(0)
  chiHo         BigInt   @default(0)
  marginPct     Float    @default(0)
  note          String?
  /// LOF-V1 — bản này ĐÓNG VAI GÌ trong hồ sơ khách: QUOTE | CONTRACT | ACCEPTANCE.
  /// null = bản làm việc nội bộ (đa số). Trước đây vai trò chỉ nằm trong `note` tự do nên máy
  /// không biết "so cặp nào ra cột chênh lệch" — bản xuất nghiệm thu cần đúng thông tin này.
  /// Một sheet ĐƯỢC PHÉP có nhiều bản cùng kind (hợp đồng điều chỉnh); bản xuất mặc định lấy bản
  /// mới nhất của mỗi kind và vẫn cho chọn tay.
  kind          String?
  /// CO/CE v3 — bản này sinh ra từ đâu: "IMPORT" = từ file khách trả về (CE-4). Null = lưu tay.
  origin        String?
  /// Khoá file khách trả (storage/costsheet-imports) — giữ lại để đối chiếu về sau.
  importFileKey String?
  createdById   String?
  createdAt     DateTime @default(now())
  snapshotJson  String // JSON: { sections: [{code,nameVi,isProxy,lines:[{itemName,lineType,quantity,unit,unitPrice,fixedAmount,percentVal,amount}]}], totals }

  costSheet              CostSheet   @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  createdBy              Staff?      @relation("CostSheetRevisionCreatedBy", fields: [createdById], references: [id])
  // Back-relation cho CostSheet.sentToLiquidationRevisionId (0-1 CostSheet thực tế trỏ tới, nhưng
  // Prisma yêu cầu khai báo dạng list ở phía "many" của quan hệ FK không unique).
  liquidationOfCostSheet CostSheet[] @relation("CostSheetLiquidationRevision")

  @@unique([costSheetId, revNo])
  @@map("cost_sheet_revision")
}

/// Bản sao cấp instance của hạng mục (section) — sinh ra khi load template hoặc thêm tay,
/// thuộc về 1 CostSheet cụ thể (khác CostsheetTemplateSection là bản mẫu dùng lại nhiều lần).
model CostSheetSection {
  id              String  @id @default(cuid())
  costSheetId     String
  code            String
  icon            String?
  nameVi          String
  nameEn          String?
  colorSlot       String?
  sort            Int     @default(0)
  isProxy         Boolean @default(false)
  /// Phòng ban phụ trách hạng mục (Department.code) — quyết định prefix mã của MỌI dòng bên trong.
  /// Dòng thừa kế từ hạng mục, không gắn phòng riêng từng dòng (đã chốt: 217 dòng của T013 mà
  /// chọn tay từng dòng là không khả thi). Null = chưa gán, mã dòng rơi về prefix chung.
  departmentCode  String?
  proxyFeeType    String? // PCT | FIXED
  proxyFeeVal     Float?
  /// CO/CE v3 — PHÍ QUẢN LÝ BÁO KHÁCH của mục LAYER 1 (10 / 5 / nhập tay). Null = mục CHƯA áp phí
  /// (chính là điều kiện "thiếu mục" chặn xuất báo giá). Chỉ có nghĩa trên mục gốc không Chi hộ.
  /// ⚠ ĐỪNG NHẦM với `CostSheet.mgmtFeePct` — đó là phí quản lý NỘI BỘ cộng vào CO
  /// (tham số computeCostSheetTotals). Hai đại lượng khác nhau hoàn toàn.
  clientFeePct    Float?
  parentSectionId String? // N-cấp (Mục→Nhóm→Sub-nhóm→...) — chỉ áp dụng nhánh THƯỜNG; mục Chi hộ (isProxy) luôn ở gốc (parentSectionId null), xem lib/bidding.ts flattenSectionTree.

  costSheet CostSheet          @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  parent    CostSheetSection?  @relation("CostSheetSectionParent", fields: [parentSectionId], references: [id], onDelete: Cascade)
  children  CostSheetSection[] @relation("CostSheetSectionParent")
  lines     CostLine[]

  @@map("cost_sheet_section")
}

model CostLine {
  id                String  @id @default(cuid())
  costSheetId       String
  sectionId         String
  /// Định danh BỀN của dòng, do builder sinh một lần và đi theo payload qua MỌI lần lưu.
  /// Cần vì saveCostSheet xoá-tạo-lại toàn bộ section/line nên `id` đổi sau mỗi lần lưu, không
  /// dùng làm khoá liên kết được. Module ④ (FinanceCostLine.lineKey) khoá vào ĐÂY — nhờ vậy mã
  /// hiển thị `itemCode` được tự do đánh lại số mà không làm đứt liên kết tạm ứng/thanh toán.
  /// ĐỪNG đổi giá trị này khi sửa dòng; đổi = mất dấu tiền đã ứng.
  stableKey         String?
  /// Mã hiển thị `{prefix phòng ban}-{số thứ tự}` — CHỈ để đọc, hệ thống tự đánh lại khi thêm/xoá.
  itemCode          String?
  lineType          String  @default("QTY_PRICE") // QTY_PRICE | FIXED | PERCENT_OF_TOTAL
  itemName          String
  specs             String?
  quantity          Float   @default(1)
  unit              String?
  unitPrice         BigInt  @default(0) // dùng khi lineType=QTY_PRICE
  fixedAmount       BigInt? // dùng khi lineType=FIXED
  percentVal        Float? // dùng khi lineType=PERCENT_OF_TOTAL
  taxType           String  @default("VAT") // VAT (khấu trừ, không gross-up) | TNCN (÷0,9) | TNDN (÷0,8) | OTHER (nhập tay customTaxAmount) — xem TAX_GROSSUP trong lib/bidding.ts
  customTaxAmount   BigInt? // chỉ dùng khi taxType=OTHER — số tiền thuế nhập tay, cộng thẳng vào base (không gross-up theo %)
  amount            BigInt  @default(0) // computed theo lineType + gross-up thuế (tính app-side, xem công thức trong lib/bidding.ts)
  vendorId          String?
  isLocked          Boolean @default(false)
  maxMarkupPct      Float?
  /// Cờ "TCM hỗ trợ" (form BM02: dòng tài trợ) — trên BÁO GIÁ dòng này hiện đơn giá nhưng Thành
  /// tiền ĐỂ TRỐNG và không tính tiền khách (CE dòng = 0), kèm ghi chú "TCM hỗ trợ dự án này".
  /// CHỈ tác động cách trình bày CE; CO của dòng vẫn tính bình thường (có thể có tiền hoặc 0).
  isSponsored       Boolean @default(false)
  /// K3 — dòng thuộc CẶP "hàng lấy từ kho + hàng mua bù". Giá trị = `StockRequestLine.id` của đề
  /// xuất GIỮ CHỖ đã duyệt, đặt trên CẢ HAI dòng của cặp → cũng là khoá GỘP khi in báo giá BM02
  /// (2 dòng nội bộ thành 1 dòng khách nhìn). CỐ Ý không unique (hai dòng cùng khoá là đúng ý) và
  /// không khai quan hệ Prisma — giữ đúng nếp `FinanceCostLine.lineKey`: cột phải sống sót qua
  /// vòng xoá-tạo-lại của saveCostSheet.
  stockResvLineId   String?
  /// K3 — ĐƠN GIÁ THAM CHIẾU của dòng lấy từ kho. Hàng này đã tính tiền ở hợp đồng trước nên
  /// `unitPrice = 0` (CO = 0 do SỐ HỌC, không do nhánh if). Giá tham chiếu CHỈ dùng ở tầng trình
  /// bày: (a) trọng số chia tiền khách trên báo giá, (b) gợi ý make-up trong builder.
  /// KHÔNG vào coTotal / ceTotal / margin / trần chi. Khác null = đây LÀ dòng lấy từ kho.
  stockRefUnitPrice BigInt?
  /// LOF-V1 — nhãn CHẶNG của dòng: tỉnh / điểm / đợt (vd "Bình Dương", "Phú Thọ"). THUẦN NHÃN:
  /// không vào coTotal / ceTotal / margin / trần chi, không có bảng danh mục, người dùng tự gõ.
  /// Dùng để GOM khi xuất bản nghiệm thu gửi khách (mỗi chặng một khối HĐ · NT · chênh lệch) —
  /// thay 78 cột Excel làm tay của team Account. Dòng không gắn nhãn rơi vào khối "Chung".
  /// Mỗi dòng TỰ mang nhãn (không kế thừa từ hạng mục lúc đọc) để chỉ có một nguồn sự thật;
  /// nút "áp nhãn cho cả nhánh" ở builder chỉ là tiện ích điền hộ.
  legCode           String?
  sort              Int     @default(0)
  note              String?

  /// ── CO/CE v3 — CE THEO DÒNG (CE-1, 05/08/2026) ─────────────────────────────────────────────
  /// Cả 5 cột dưới đây null = dòng thuộc bảng CHẾ ĐỘ CŨ (CE vẫn ở cấp bảng, phân bổ BM02 khi in).
  /// Nhận diện chế độ: `sheetHasLineCe` trong lib/bidding.ts — KHÔNG có cột cờ riêng.
  /// CE SL/đơn giá của dòng (hoặc của NHÓM nếu dòng là đại diện nhóm — xem ceGroupKey).
  ceQuantity  Float?
  ceUnitPrice BigInt?
  /// Khoá GỘP N dòng CO → 1 dòng CE khách nhìn (mirror nếp `stockResvLineId` của cặp kho K3:
  /// đặt trên MỌI dòng của nhóm, sinh kiểu stableKey, sống sót vòng xoá-tạo-lại của saveCostSheet).
  /// Dòng ĐẦU TIÊN theo sort của nhóm là ĐẠI DIỆN — ceName/ceQuantity/ceUnitPrice đọc từ nó.
  /// ⚠ Cặp kho K3 là nhóm CÓ SẴN: không trộn thêm dòng khác vào cặp (validator chặn).
  ceGroupKey  String?
  /// Nhãn CE hiển thị cho khách — chỉ có nghĩa trên dòng đại diện; null = dùng itemName.
  ceName      String?
  /// %VAT của dòng taxType=VAT (8 | 10). Null = chưa chọn → trần chi GIỮ = net (quyết định Q4).
  /// Chỉ vào TRẦN CHI (payCap), KHÔNG vào amount/coTotal — VAT là thuế khấu trừ.
  vatPct      Float?
  /// CE-5 — KHÁCH YÊU CẦU BỎ dòng này khỏi báo giá. Dòng vẫn nằm trong bảng, hiển thị GẠCH NGANG,
  /// CE = 0; Account tự quyết: xoá hẳn, hay thương lượng khôi phục nguyên/một phần (quyết định chủ
  /// dự án 05/08/2026 — KHÔNG xoá tự động, vì dòng đã xoá là mất dấu để thương lượng lại).
  /// ⚠ Cột này tác động cách tính CE: `ceRowsOf` bỏ qua dòng dropped khi cộng CE và khi xuất báo
  /// giá. CO của dòng vẫn tính bình thường — hàng vẫn phải mua nếu Account chưa quyết bỏ.
  ceDropped   Boolean   @default(false)

  costSheet CostSheet        @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  section   CostSheetSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  vendor    Vendor?          @relation(fields: [vendorId], references: [id])

  /// Hai dòng cùng stableKey trong một bảng sẽ bị module ④ GỘP làm một (FinanceCostLine khoá theo
  /// lineKey) và tiền của một dòng biến mất im lặng. Ràng buộc này biến lỗi đó thành lỗi nổ ngay.
  /// saveCostSheet đã khử trùng trước khi ghi nên từ giao diện không chạm tới được.
  @@unique([costSheetId, stableKey])
  @@map("cost_line")
}

/// Hợp đồng — bản ghi gọn (không workflow trạng thái). confirm_email_at = cổng bắt đầu thực thi (FR-04).
model Contract {
  id                            String    @id @default(cuid())
  projectId                     String    @unique
  contractNo                    String?
  contractDate                  DateTime?
  poNo                          String?
  poDate                        DateTime?
  paymentTermDays               Int?
  templateSource                String? // CLIENT | TCM
  signed                        Boolean   @default(false)
  confirmEmailAt                DateTime?
  fileUrl                       String?
  note                          String?
  // Kế toán xác nhận "Hợp đồng đã xong" — dừng reminder 7-ngày của trạng thái Đang triển khai.
  accountantConfirmedAt         DateTime?
  accountantConfirmedById       String?
  // Kế toán xác nhận "Đã nhận đủ hồ sơ nghiệm thu" — dừng reminder hàng tuần của Đang nghiệm thu.
  acceptanceDocsConfirmedAt     DateTime?
  acceptanceDocsConfirmedById   String?
  // Project Leader/Owner tick "Khách hàng xác nhận nghiệm thu" sau khi khách ký.
  clientAcceptanceConfirmedAt   DateTime?
  clientAcceptanceConfirmedById String?
  // Mốc dự kiến khách ký nghiệm thu — Leader/Owner đặt ở tab Nghiệm thu; cũng là mốc nhắc hệ thống
  // (getAcceptanceSignReminders/checkAcceptanceSignReminders trong lib/reminders.ts).
  expectedAcceptanceSignDate    DateTime?
  acceptanceReminderSentAt      DateTime? // đã gửi notification nhắc quá hạn (idempotent — reset khi đổi mốc)
  // Kế toán xuất hóa đơn sau khi nghiệm thu.
  invoiceNo                     String?
  invoiceDate                   DateTime?
  invoiceById                   String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  project                     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountantConfirmedBy       Staff?  @relation("ContractAccountantConfirmedBy", fields: [accountantConfirmedById], references: [id])
  acceptanceDocsConfirmedBy   Staff?  @relation("ContractAcceptanceDocsConfirmedBy", fields: [acceptanceDocsConfirmedById], references: [id])
  clientAcceptanceConfirmedBy Staff?  @relation("ContractClientAcceptanceConfirmedBy", fields: [clientAcceptanceConfirmedById], references: [id])
  invoiceBy                   Staff?  @relation("ContractInvoiceBy", fields: [invoiceById], references: [id])

  @@map("contract")
}

// ─────────────────────────────────────────────────────────
// MODULE ③ QUẢN LÝ DỰ ÁN — Project Team, Master Timeline (Internal/External), Guest Portal
// ─────────────────────────────────────────────────────────

/// Thành viên tham gia dự án (đa phòng ban). Core = Creative/PRO/OPE/PCC · Support = Planning/HR/IT.
model ProjectMember {
  id            String   @id @default(cuid())
  projectId     String
  staffId       String
  roleInProject String   @default("CORE") // LEADER | CORE | SUPPORT
  note          String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@unique([projectId, staffId])
  @@map("project_member")
}

/// Hạng mục Master Timeline. 1 bảng chứa cả field nội bộ + override external (chia sẻ cho khách).
/// External Timeline = các item `isShared && externalPublished`. Guest chỉ ghi được clientStatus/clientNote
/// và CHỈ khi `clientEditable` = true (enforce ở server action guest).
model TimelineItem {
  id                    String    @id @default(cuid())
  projectId             String
  parentId              String? // Phase (cha) → Task (con); null = item gốc/Phase
  title                 String
  startDate             DateTime?
  endDate               DateTime?
  ownerStaffId          String? // người phụ trách nội bộ (PIC chính / PIC TCM) — resolve department để tự sinh ORDER
  secondaryOwnerStaffId String? // PIC phụ (KUN: "Thực hiện" vs "Chuẩn bị"; JBVN: PIC phụ)
  departmentCode        String? // ACCOUNT|PLANNING|CREATIVE|OPE|PRO|PCC|FIN|HR|IT|CEO (hiển thị/fallback, không FK)
  accountableParty      String? // JBVN cột "PIC" = bên chịu trách nhiệm (TCM/JBVN/vendor) — free text
  quantity              Float? // KUN: Số lượng
  unit                  String? // KUN: ĐVT (bộ, tờ, thùng...)
  templateItemId        String? // provenance từ TimelineTemplateItem (không FK cứng)
  statusId              String? // option_set "timeline_status"
  sort                  Int       @default(0)
  // ── External override ──
  isShared              Boolean   @default(false) // Leader chọn share ra ngoài
  externalPublished     Boolean   @default(false) // Owner duyệt mới lộ cho guest
  externalTitle         String? // nhãn hiển thị cho khách (nếu khác nội bộ)
  externalStartDate     DateTime?
  externalEndDate       DateTime?
  clientEditable        Boolean   @default(false) // cờ "cho khách sửa" từng item
  clientStatus          String? // guest ghi: PENDING | CONFIRMED | NEEDS_DISCUSSION
  clientNote            String? // guest ghi
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         TimelineItem?  @relation("TimelineItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       TimelineItem[] @relation("TimelineItemHierarchy")
  ownerStaff     Staff?         @relation("TimelineItemOwner", fields: [ownerStaffId], references: [id])
  secondaryOwner Staff?         @relation("TimelineItemOwner2", fields: [secondaryOwnerStaffId], references: [id])
  status         OptionItem?    @relation("TimelineItemStatus", fields: [statusId], references: [id])

  comments   TimelineComment[]
  orderItems ProjectOrderItem[] @relation("OrderItemSource")

  @@index([projectId, sort])
  @@map("timeline_item")
}

/// Bình luận / xác nhận trên 1 hạng mục timeline — từ cả nội bộ (STAFF) lẫn khách (GUEST).
model TimelineComment {
  id            String   @id @default(cuid())
  itemId        String
  authorType    String // STAFF | GUEST
  authorStaffId String?
  authorGuestId String? // GuestInvite.id
  body          String
  createdAt     DateTime @default(now())

  item        TimelineItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  authorStaff Staff?       @relation("TimelineCommentStaff", fields: [authorStaffId], references: [id])
  authorGuest GuestInvite? @relation(fields: [authorGuestId], references: [id])

  @@index([itemId, createdAt])
  @@map("timeline_comment")
}

/// Lời mời guest (PIC khách) qua magic-link. LƯU HASH của token, không lưu token thô.
/// Guest chỉ thấy đúng 1 dự án được mời, chỉ item shared+published.
model GuestInvite {
  id           String    @id @default(cuid())
  projectId    String
  contactId    String? // nối Contact (PIC khách) nếu có
  email        String
  name         String
  tokenHash    String    @unique // sha256(token thô)
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastAccessAt DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact   Contact?          @relation(fields: [contactId], references: [id])
  createdBy Staff?            @relation("GuestInviteCreatedBy", fields: [createdById], references: [id])
  comments  TimelineComment[]

  @@index([projectId])
  @@map("guest_invite")
}

/// Phiếu đặt lại mật khẩu (link "Quên mật khẩu" gửi qua email, hoặc admin cấp tay).
/// Chỉ lưu HASH của token — token thô chỉ tồn tại trong link gửi đi, đúng như GuestInvite ở trên.
/// Token dùng 1 lần (`usedAt`) và có hạn ngắn (mặc định 60 phút, xem src/lib/auth-session.ts).
model PasswordResetToken {
  id        String    @id @default(cuid())
  staffId   String
  tokenHash String    @unique // sha256(token thô)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String? // null = do chính user bấm "Quên mật khẩu"; có giá trị = admin cấp lại hộ

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("password_reset_token")
}

/// Mẫu Master Timeline — 1 model chung, nhiều mẫu theo Nhóm dự án (project_type), 2 kiểu xem:
/// GANTT (như JBVN: cột ngày + vòng revise thiết kế) · CHECKLIST (như KUN: qty/ĐVT + ma trận nhân sự).
/// columnsJson bật/tắt cột hiển thị. Runtime vật hóa mẫu → TimelineItem cho từng dự án.
model TimelineTemplate {
  id            String   @id @default(cuid())
  name          String
  projectTypeId String?
  viewMode      String   @default("GANTT") // GANTT | CHECKLIST
  columnsJson   String? // JSON string[] cột bật: pic2|accountable|duration|deadline|qty|unit|status
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projectType OptionItem?               @relation("TimelineTemplateProjectType", fields: [projectTypeId], references: [id])
  sections    TimelineTemplateSection[]

  @@map("timeline_template")
}

/// Hạng mục (Phase/Section) trong 1 mẫu timeline — vd VENUE/DESIGN (JBVN), CHUẨN BỊ/HÀNG HÓA (KUN).
model TimelineTemplateSection {
  id         String  @id @default(cuid())
  templateId String
  code       String
  nameVi     String
  nameEn     String?
  sort       Int     @default(0)

  template TimelineTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    TimelineTemplateItem[]

  @@map("timeline_template_section")
}

/// Dòng mẫu trong hạng mục — seed khung Item/Task. parentLabel gom Item→Sub-task (null = Item cấp 1).
model TimelineTemplateItem {
  id                    String  @id @default(cuid())
  sectionId             String
  parentLabel           String? // gom sub-task dưới 1 Item (khớp title Item cha); null = Item cấp 1
  title                 String
  defaultDepartmentCode String?
  defaultDurationDays   Int?
  defaultUnit           String?
  defaultQty            Float?
  sort                  Int     @default(0)

  section TimelineTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("timeline_template_item")
}

/// Ma trận nhân sự (KUN) — hàng = vai trò, cột = khu vực hoạt động, ô = số lượng. Bảng phẳng,
/// app-side gom distinct roleLabel/zoneLabel thành lưới. Hiển thị khi mẫu timeline viewMode=CHECKLIST.
model ProjectStaffing {
  id        String @id @default(cuid())
  projectId String
  roleLabel String // MC | PG/PB | Mascot | Sup | Helper...
  zoneLabel String // Phát leaflet | Check in | Bán hàng | Game...
  headcount Int    @default(0)
  sort      Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sort])
  @@map("project_staffing")
}

// ─────────────────────────────────────────────────────────
// MODULE CREATIVE — Task giao cho team Creative (cost-per-task/lương ở đợt sau)
// ─────────────────────────────────────────────────────────

/// Team NHỎ bên trong phòng Creative (CR-1, quyết định chủ dự án 06/08/2026):
/// CREATIVE (idea, chiến lược) · GRAPHIC_2D (Key Visual, master KV) · MULTIMEDIA (3D/Animation/AI).
///
/// ⚠ CỐ Ý là bảng RIÊNG, KHÔNG nhét vào `Team` — bảng đó LÀ team Account (A1/A2/A3) và lan ra
/// ~15 picker, mã dự án (lib/bidding.ts), quỹ KPI, org chart. Cũng không phải Department con:
/// CREATIVE vẫn là MỘT phòng, squad chỉ là tầng điều phối việc bên trong.
///
/// `leadStaffId` = trưởng team nhỏ — người GIAO người trong team sau khi CD điều phối task về team.
/// Quyền của trưởng team kiểm THEO BẢN GHI trong action (mẫu Team.leadStaffId của Planning),
/// KHÔNG có mã quyền riêng. 3 squad do seed dựng (marker một lần), chỉ bật/tắt — không có đường xoá.
model CreativeSquad {
  id          String   @id @default(cuid())
  code        String   @unique // CREATIVE | GRAPHIC_2D | MULTIMEDIA
  name        String
  leadStaffId String?
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead    Staff?         @relation("CreativeSquadLead", fields: [leadStaffId], references: [id])
  members Staff[]        @relation("StaffCreativeSquad")
  tasks   CreativeTask[]

  @@map("creative_squad")
}

/// 1 tác vụ cụ thể team Creative phải làm. Tự sinh từ checklist Order Creative (sourceItemLabel dedupe)
/// hoặc CD tạo lẻ. Phase BIDDING/WORKING tính realtime từ project.status.code (không lưu).
/// Vòng đời: UNASSIGNED → ASSIGNED → SUBMITTED → (REVISION ↺) → DELIVERED · CANCELED = bị khóa theo project.
/// CR-1: `squadId` = task đã ĐIỀU PHỐI về team nhỏ nào ("đã về team" là THUỘC TÍNH, không phải
/// status mới — CD re-route được bất kỳ lúc nào và vẫn giao thẳng người được như cũ).
model CreativeTask {
  id                     String    @id @default(cuid())
  projectId              String
  orderId                String? // ProjectOrder(CREATIVE) nguồn
  orderItemId            String? // ProjectOrderItem gốc (chỉ task sinh từ Master Timeline) — để đẩy status→DONE khi DELIVERED
  orderedById            String? // snapshot người ORDER (order.sentById ?? project.ownerId) — nơi trả thành phẩm
  sourceItemLabel        String? // nhãn ProjectOrderCreativeItem gốc (dedupe khi tự sinh)
  squadId                String? // CR-1: team nhỏ được điều phối — spawn gợi ý theo nhãn, CD sửa được
  taskTypeId             String? // option_set "creative_task_type" — CD chọn lúc giao
  title                  String
  detail                 String?
  status                 String    @default("UNASSIGNED") // UNASSIGNED | ASSIGNED | SUBMITTED | REVISION | DELIVERED | CANCELED
  assigneeId             String?
  assignedById           String? // CD giao việc
  assignedAt             DateTime?
  cdApprovalNotRequired  Boolean   @default(false) // tick "CD không cần duyệt" → GỬI đi thẳng cho người ORDER
  deadline               DateTime?
  deliverableLinkUrl     String? // link Drive/OneDrive
  hoursSpent             Float? // số giờ NV điền — bội số 0.25
  submittedAt            DateTime?
  revisionCount          Int       @default(0) // số lần CD trả lại — dùng đo chất lượng (duyệt lần 1?)
  reviewedById           String?
  reviewedAt             DateTime?
  deliveredAt            DateTime?
  deadlineReminderSentAt DateTime? // đã gửi notification nhắc quá hạn (idempotent — reset khi đổi deadline)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  squad      CreativeSquad?         @relation(fields: [squadId], references: [id], onDelete: SetNull)
  order      ProjectOrder?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem  ProjectOrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  taskType   OptionItem?            @relation("CreativeTaskType", fields: [taskTypeId], references: [id])
  assignee   Staff?            @relation("CreativeTaskAssignee", fields: [assigneeId], references: [id])
  assignedBy Staff?            @relation("CreativeTaskAssignedBy", fields: [assignedById], references: [id])
  reviewedBy Staff?            @relation("CreativeTaskReviewedBy", fields: [reviewedById], references: [id])
  orderedBy  Staff?            @relation("CreativeTaskOrderedBy", fields: [orderedById], references: [id])

  @@unique([orderId, sourceItemLabel]) // backstop DB cho spawn idempotent — 2 dispatch song song không tạo task trùng (NULL không đụng nhau trong SQLite)
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([orderItemId])
  @@map("creative_task")
}

// ─────────────────────────────────────────────────────────
// TASK NỘI BỘ THEO BỘ PHẬN — Planning/Purchasing/Operations/Production
// (Creative dùng CreativeTask riêng ở trên — KHÔNG đụng)
// ─────────────────────────────────────────────────────────

/// 1 tác vụ cụ thể giao cho PLANNING|PCC|OPE|PRO. Tự sinh từ ProjectOrderItem (dòng gom từ Master
/// Timeline, sourceKey="TL:{sourceTimelineItemId ?? itemId}") lúc dispatch order, hoặc từ chính order
/// khi order không có dòng nào (order Account nhập tay, sourceKey="ORDER:{orderId}"). Vòng đời mirror
/// CreativeTask: UNASSIGNED → ASSIGNED → SUBMITTED → (REVISION ↺) → DELIVERED · CANCELED = bị khóa theo project.
model DepartmentTask {
  id                      String    @id @default(cuid())
  projectId               String
  department              String // PLANNING | PCC | OPE | PRO
  orderId                 String? // ProjectOrder nguồn
  orderItemId             String? // ProjectOrderItem gốc (chỉ task sinh từ Master Timeline) — để đẩy status→DONE khi DELIVERED
  orderedById             String? // snapshot người ORDER (order.sentById ?? project.ownerId) — nơi trả kết quả
  sourceKey               String? // "TL:{sourceTimelineItemId ?? itemId}" | "ORDER:{orderId}" — idempotent dedupe
  title                   String
  detail                  String?
  status                  String    @default("UNASSIGNED") // UNASSIGNED | ASSIGNED | SUBMITTED | REVISION | DELIVERED | CANCELED
  assigneeId              String?
  assignedById            String? // lead giao việc
  assignedAt              DateTime?
  leadApprovalNotRequired Boolean   @default(false) // tick "không cần lead duyệt" → GỬI đi thẳng cho người ORDER
  deadline                DateTime?
  deliverableLinkUrl      String? // link Drive/OneDrive
  hoursSpent              Float? // số giờ NV điền — bội số 0.25
  submittedAt             DateTime?
  revisionCount           Int       @default(0)
  reviewedById            String?
  reviewedAt              DateTime?
  deliveredAt             DateTime?
  deadlineReminderSentAt  DateTime? // đã gửi notification nhắc quá hạn (idempotent — reset khi đổi deadline)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order      ProjectOrder?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem  ProjectOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  assignee   Staff?            @relation("DepartmentTaskAssignee", fields: [assigneeId], references: [id])
  assignedBy Staff?            @relation("DepartmentTaskAssignedBy", fields: [assignedById], references: [id])
  reviewedBy Staff?            @relation("DepartmentTaskReviewedBy", fields: [reviewedById], references: [id])
  orderedBy  Staff?            @relation("DepartmentTaskOrderedBy", fields: [orderedById], references: [id])

  @@unique([orderId, sourceKey]) // backstop DB cho spawn idempotent — 2 dispatch song song không tạo task trùng (NULL không đụng nhau trong SQLite)
  @@index([projectId, department, status])
  @@index([assigneeId, status])
  @@index([orderItemId])
  @@map("department_task")
}

/// Cost-per-task Creative (Kế hoạch vs Thực tế). Lương lưu theo VỊ TRÍ (Staff.title), KHÔNG theo cá nhân
/// (app chưa có RBAC thật). Kỳ = periodCode tự mô tả ("2026-M07"|"2026-Q3"|"2026-H2"|"2026").
model CreativeSalaryBudget {
  id                String   @id @default(cuid())
  positionTitle     String // khớp Staff.title của nhân sự CREATIVE
  periodCode        String
  monthlySalary     BigInt // VND/tháng cho MỘT người ở vị trí này
  headcountOverride Int? // null = suy ra live từ Staff active CREATIVE cùng title; set = chốt cứng cho kỳ đã đóng
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([positionTitle, periodCode])
  @@map("creative_salary_budget")
}

/// Ma trận phân bổ % (kế hoạch): vị trí × loại task → % quỹ lương kỳ. Không ép tổng = 100 (cảnh báo, không chuẩn hóa).
model CreativeAllocationRatio {
  id            String   @id @default(cuid())
  positionTitle String
  taskTypeId    String
  periodCode    String
  percent       Float    @default(0) // 0..100
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  taskType OptionItem @relation("CreativeRatioTaskType", fields: [taskTypeId], references: [id], onDelete: Cascade)

  @@unique([positionTitle, taskTypeId, periodCode])
  @@map("creative_allocation_ratio")
}

// ─────────────────────────────────────────────────────────
// MODULE ④ CHI PHÍ & CÔNG NỢ — Tạm ứng · Thanh toán NCC · Công nợ
// ─────────────────────────────────────────────────────────

/// Bản đồng bộ (read-only) các dòng CO nội bộ từ CO/CE (Quản lý dự án) xuống Finance để làm tạm ứng.
/// CostLine.id bị tạo lại mỗi lần lưu CO/CE → gắn tạm ứng theo lineKey ổn định (=sectionCode‖itemName),
/// nút Refresh đồng bộ lại từ CostSheet CTRACT mới nhất, giữ nguyên lịch sử tạm ứng đã gắn.
model FinanceCostLine {
  id          String   @id @default(cuid())
  projectId   String
  /// = CostLine.stableKey. TRƯỚC ĐÂY là `sectionCode‖itemName` — đổi vì mã hạng mục do builder
  /// gán cứng "SECTION" cho mọi hạng mục, khiến 2 dòng trùng tên ở 2 hạng mục khác nhau bị gộp
  /// làm một khi sang module ④ (tiền của 2 khoản chi cộng dồn vào 1 dòng).
  lineKey     String
  /// Mã hiển thị chép từ CostLine.itemCode (ACC-001…) — chỉ để đọc, KHÔNG dùng làm khoá.
  itemCode    String?
  sectionCode String
  sectionName String
  itemName    String
  specs       String?
  amount      BigInt   @default(0) // chi phí nội bộ của dòng, ĐÃ gross-up thuế (đồng bộ từ CostLine.amount)
  /// Số tiền THỰC TRẢ ra ngoài (trước gross-up TNCN/TNDN, chưa cộng customTaxAmount) — TRẦN cho
  /// tổng mọi khoản chi của dòng: thanh toán NCC + tạm ứng NV + tạm ứng chuyển thẳng NCC.
  /// Không dùng `amount` làm trần: phần gross-up là thuế công ty nộp hộ, không trao cho ai.
  netAmount   BigInt   @default(0)
  /// CO/CE v3 — TRẦN CHI hiệu lực của dòng: dòng VAT đã chọn % thì = netAmount × (1 + vatPct/100)
  /// (số phải trả NCC gồm VAT); còn lại = netAmount (Q4: VAT chưa chọn % giữ trần cũ). Ba cửa
  /// kiểm trần ở finance/actions.ts đọc CỘT NÀY thay vì netAmount từ CE-1. Backfill = netAmount.
  payCap      BigInt   @default(0)
  /// Dòng thuộc hạng mục Chi hộ (CostSheetSection.isProxy). Chi hộ là tiền ứng giùm khách, NẰM
  /// NGOÀI giá vốn (bất biến #2) — nên nó có trần chi riêng theo từng dòng như mọi dòng khác,
  /// nhưng KHÔNG được cộng vào trần cấp dự án (xem projectDisbursement) và không vào margin.
  isProxy     Boolean  @default(false)
  vendorId    String?
  sourceRevNo Int      @default(0) // revNo của CostSheetRevision đã đồng bộ gần nhất
  sort        Int      @default(0)
  isStale     Boolean  @default(false) // dòng không còn ở version CO/CE mới nhất (giữ lại vì có tạm ứng)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor             Vendor?             @relation(fields: [vendorId], references: [id])
  advances           Advance[]
  vendorPayments     VendorPayment[]
  ctvRows            CtvContract[]       @relation("CtvRowLine")
  ctvBatchesDefault  CtvBatch[]          @relation("CtvBatchDefaultLine")
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([projectId, lineKey])
  @@index([projectId])
  @@map("finance_cost_line")
}

/// 1 lần tạm ứng (installment) gắn vào 1 dòng CO. Nhiều lần/dòng nhưng tổng ≤ giá trị dòng.
model Advance {
  id                String    @id @default(cuid())
  financeCostLineId String
  projectId         String // denormalize để check hạn mức chéo dự án theo NV
  installmentNo     Int // lần 1/2/…
  amount            BigInt
  advanceType       String // VENDOR (Ứng trực tiếp NCC) | STAFF (Ứng cho NV TCM)
  recipientVendorId String? // khi VENDOR
  recipientStaffId  String? // khi STAFF — NV giữ tạm ứng (đối tượng tính hạn mức)
  bankName          String?
  bankAccountNo     String?
  bankAccountHolder String?
  note              String?
  status            String    @default("REQUESTED") // REQUESTED | DISBURSED | SETTLED | CANCELED
  requestedById     String?
  requestedAt       DateTime  @default(now())
  disbursedById     String? // Kế toán "Xác nhận tạm ứng xong" (thực chi)
  disbursedAt       DateTime?
  settledById       String? // "Hoàn ứng" — giải phóng hạn mức
  settledAt         DateTime?
  settleNote        String?
  /// Huỷ SAU KHI đã giải ngân = tiền đã chi ra nay thu hồi được (chi nhầm, đổi phương án).
  /// Bắt buộc có lý do vì thao tác này trả lại trần chi cho dòng — không được làm im lặng.
  canceledById      String?
  canceledAt        DateTime?
  cancelNote        String?

  financeCostLine FinanceCostLine @relation(fields: [financeCostLineId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipientVendor Vendor?         @relation("AdvanceRecipientVendor", fields: [recipientVendorId], references: [id])
  recipientStaff  Staff?          @relation("AdvanceRecipientStaff", fields: [recipientStaffId], references: [id])
  requestedBy     Staff?          @relation("AdvanceRequestedBy", fields: [requestedById], references: [id])
  disbursedBy     Staff?          @relation("AdvanceDisbursedBy", fields: [disbursedById], references: [id])
  settledBy       Staff?          @relation("AdvanceSettledBy", fields: [settledById], references: [id])

  @@index([recipientStaffId, status])
  @@index([projectId])
  @@map("advance")
}

/// Thanh toán cho NCC (khung best-practice): phiếu chi theo NCC/dự án, đánh dấu đã trả.
model VendorPayment {
  id                String    @id @default(cuid())
  vendorId          String
  projectId         String?
  /// Dòng chi phí CO/CE mà khoản chi này thuộc về — nguồn để tính "còn lại chưa thanh toán" cho
  /// TỪNG dòng item cost. Nullable: khoản chi cấp dự án không gắn dòng nào vẫn hợp lệ.
  financeCostLineId String?
  amount            BigInt
  dueDate           DateTime?
  paidDate          DateTime?
  status            String    @default("SCHEDULED") // SCHEDULED | PAID | CANCELED
  invoiceNo         String?
  note              String?
  /// Lý do lập phiếu VƯỢT trần chi của dự án — có giá trị = phiếu đã vượt trần (hiện badge cảnh
  /// báo ở danh sách). Null = phiếu nằm trong trần. Đòi quyền finance.vendor_payment.over_cap.
  overCapNote       String?
  /// Huỷ phiếu lập nhầm (chỉ khi CHƯA trả — phiếu đã trả phải "bỏ đánh dấu đã trả" trước).
  /// KHÔNG xoá bản ghi; phiếu huỷ bị loại khỏi trần chi, cashflow và danh sách.
  canceledById      String?
  canceledAt        DateTime?
  cancelNote        String?
  /// Đợt CTV (BM08) sinh ra phiếu này qua "Đề xuất thanh toán CTV" — mỗi phiếu = tổng tiền các
  /// dòng CTV của MỘT dòng CO trong đợt. SetNull: xoá đợt không được xoá phiếu chi đã lập.
  ctvBatchId        String?
  /// PO (C3) mà phiếu chi này thanh toán — chân thứ 3 của đối chiếu ĐẶT ↔ NHẬN ↔ CHI. SetNull.
  purchaseOrderId   String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       Staff?           @relation("VendorPaymentCreatedBy", fields: [createdById], references: [id])
  // SetNull chứ không Cascade: dòng CO/CE biến mất (đổi tên/xoá ở bản mới) KHÔNG được làm mất
  // chứng từ đã chi — khoản chi vẫn còn, chỉ mất liên kết dòng.
  financeCostLine FinanceCostLine? @relation(fields: [financeCostLineId], references: [id], onDelete: SetNull)
  ctvBatch        CtvBatch?        @relation(fields: [ctvBatchId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([vendorId, status])
  @@index([ctvBatchId])
  @@index([purchaseOrderId])
  @@map("vendor_payment")
}

/// Hóa đơn khách hàng (công nợ AR) — hỗ trợ milestone billing (nhiều HĐ/dự án).
/// C5 — Kế hoạch thu theo đợt (milestone billing) của MỘT dự án, vd "Tạm ứng 30% / Triển khai 40%
/// / Nghiệm thu 30%". Đợt định nghĩa bằng % trên TỔNG THANH TOÁN (clientBillableTotal của bảng
/// CO/CE sống) — % ĐỘNG: CE đổi thì số tiền đợt tự đổi theo, KHÔNG lưu số tiền cứng (bất biến #3);
/// phần đã xuất hóa đơn là bất biến vì hóa đơn đã phát hành không tính lại. Hạn dự kiến nhập tay.
model CollectionMilestone {
  id        String    @id @default(cuid())
  projectId String
  name      String // "Tạm ứng ký hợp đồng"…
  pct       Float // % trên tổng thanh toán
  dueDate   DateTime? // hạn thu dự kiến (nhập tay, UTC-midnight)
  sort      Int       @default(0)
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoices ClientInvoice[]

  @@index([projectId])
  @@map("collection_milestone")
}

model ClientInvoice {
  id               String    @id @default(cuid())
  projectId        String
  clientId         String
  invoiceNo        String
  invoiceDate      DateTime
  amount           BigInt
  dueDate          DateTime?
  note             String?
  /// Đợt thu (C5) mà hóa đơn này thuộc về — để theo dõi tiến độ thu theo kế hoạch. SetNull: xoá
  /// đợt không được kéo đổ hóa đơn đã phát hành.
  milestoneId      String?
  /// Lần gần nhất đã bắn nhắc nợ quá hạn. Chống spam: hóa đơn quá hạn 200 ngày mà nhắc mỗi 5 phút
  /// thì không ai đọc chuông nữa. Chu kỳ nhắc lại lấy từ setting finance.ar_reminder_repeat_days.
  arReminderSentAt DateTime?
  /// Lý do phát hành VƯỢT trần (CE + Chi hộ của CO/CE hiện hành trừ đã xuất) hoặc phát hành cho
  /// dự án CHƯA có CO/CE. Có giá trị = hóa đơn vượt trần (badge cảnh báo ở trang Công nợ).
  /// Đòi quyền finance.invoice.over_cap. Cửa Nghiệm thu có trần CỨNG riêng, không đi qua đây.
  overCapNote      String?
  /// Huỷ hóa đơn (xuất nhầm số/sai tiền). KHÔNG xoá bản ghi — số hóa đơn đã phát hành phải truy
  /// được. Hóa đơn đã huỷ bị loại khỏi MỌI phép tính công nợ và khỏi điều kiện kết thúc dự án.
  /// Chỉ huỷ được khi chưa ghi nhận lần thu nào (có thu rồi thì phải đảo khoản thu trước).
  voidedById       String?
  voidedAt         DateTime?
  voidNote         String?
  createdById      String?
  createdAt        DateTime  @default(now())

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client    Client               @relation(fields: [clientId], references: [id])
  createdBy Staff?               @relation("ClientInvoiceCreatedBy", fields: [createdById], references: [id])
  payments  ClientPayment[]
  milestone CollectionMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("client_invoice")
}

/// C3 — Đơn đặt hàng NCC (PO). Trước đây Thu mua đặt hàng qua Zalo không chứng từ: hàng về không
/// ai đối chiếu số lượng, phiếu chi không có nguồn gốc. PO KHÔNG ăn trần chi (trần vẫn chỉ tính
/// tạm ứng + phiếu chi — tránh đếm tiền hai lần khi phiếu chi lập theo PO); nó là làn CAM KẾT để
/// đối chiếu 3 chiều: ĐẶT (PO) ↔ NHẬN (receivedQty) ↔ CHI (VendorPayment gắn purchaseOrderId).
model PurchaseOrder {
  id           String    @id @default(cuid())
  code         String    @unique // {project.code}-PO{n}
  projectId    String
  vendorId     String
  status       String    @default("OPEN") // OPEN | RECEIVED | CANCELED
  note         String?
  orderedById  String?
  orderedAt    DateTime  @default(now())
  /// Huỷ PO đặt nhầm — giữ bản ghi + lý do (không xoá chứng từ). Chỉ huỷ khi CHƯA gắn phiếu chi.
  canceledById String?
  canceledAt   DateTime?
  cancelNote   String?
  updatedAt    DateTime  @updatedAt

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  lines         PurchaseOrderLine[]
  payments      VendorPayment[]
  stockRequests StockRequest[]

  @@index([projectId])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id                String    @id @default(cuid())
  purchaseOrderId   String
  /// Dòng CO/CE mà khoản đặt hàng này thuộc về — BẮT BUỘC lúc tạo (server validate; cột nullable
  /// chỉ để SetNull: dòng CO biến mất ở bản mới không được kéo đổ chứng từ đặt hàng).
  financeCostLineId String?
  itemName          String
  quantity          Float     @default(1)
  unitPrice         BigInt    @default(0)
  amount            BigInt    @default(0) // = quantity × unitPrice, server tính lại — không tin client
  /// Nhận hàng ghi NGAY TRÊN DÒNG (không dựng chứng từ nhập kho riêng — phần lớn hàng event giao
  /// thẳng ra site): SL đã nhận + ai + lúc nào. Nhận thiếu nhìn thấy ngay ở receivedQty < quantity.
  receivedQty       Float     @default(0)
  receivedById      String?
  receivedAt        DateTime?
  note              String?

  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  financeCostLine FinanceCostLine? @relation(fields: [financeCostLineId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([financeCostLineId])
  @@map("purchase_order_line")
}

/// Thanh toán nhận từ khách cho 1 hóa đơn.
model ClientPayment {
  id          String   @id @default(cuid())
  invoiceId   String
  amount      BigInt
  paidDate    DateTime
  method      String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  invoice   ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy Staff?        @relation("ClientPaymentCreatedBy", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@map("client_payment")
}

// ─────────────────────────────────────────────────────────
// MODULE ⑨ — COMMUNICATION (chat nội bộ) · Phase 1
// Không có auth thật → "act as" (lib/current-staff.ts) quyết định "tôi là ai".
// Không realtime → client poll route /api/chat/[id]/messages mỗi ~4s.
// Phase 2 (batch sau): attachment (file/ảnh/video), avatar group, share contact, poll.
// ─────────────────────────────────────────────────────────

/// Hội thoại: DIRECT (1-1, name/avatar null, tiêu đề suy từ người còn lại) hoặc GROUP.
model Conversation {
  id          String   @id @default(cuid())
  type        String   @default("DIRECT") // DIRECT | GROUP
  name        String? // group
  avatarKey   String? // group avatar — 2 dạng: bắt đầu bằng "/" = path tĩnh trong /public (VD "/brand/icon-square.png" cho "GIA ĐÌNH TCM", <img> load thẳng); KHÔNG bắt đầu bằng "/" = storageKey ảnh admin upload (xem lib/chat-storage.ts), serve qua /api/chat/group-avatar/[id] có kiểm tra membership
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy      Staff?               @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  members        ConversationMember[]
  messages       Message[]
  notifications  Notification[]
  pinnedMessages PinnedMessage[]
  reminders      Reminder[]

  @@index([type])
  @@map("conversation")
}

/// Thành viên hội thoại. Exit = hard delete row (nhất quán "không soft-delete" của app) + phát system message.
model ConversationMember {
  id                 String    @id @default(cuid())
  conversationId     String
  staffId            String
  role               String    @default("MEMBER") // ADMIN | MEMBER
  notificationsMuted Boolean   @default(false)
  lastReadAt         DateTime? // unread theo từng người
  joinedAt           DateTime  @default(now())
  historyVisibleFrom DateTime? // null = xem được toàn bộ lịch sử; có giá trị = chỉ xem tin nhắn từ mốc này trở đi
  // (set = thời điểm add khi admin chọn "không cho đọc lịch sử cũ" lúc thêm member mới —
  // xem addMembers(); KHÔNG áp dụng cho nhóm GIA ĐÌNH TCM, luôn null ở đó)
  sidebarPinnedAt    DateTime? // ghim hội thoại lên đầu danh sách CỦA RIÊNG người này (khác PinnedMessage — đó là ghim tin nhắn trong 1 hội thoại)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id])

  @@unique([conversationId, staffId])
  @@index([staffId])
  @@map("conversation_member")
}

/// Tin nhắn. senderId null cho SYSTEM. type=LINK dùng linkUrl+linkText (2 ô).
/// systemEvent điều khiển render i18n (KHÔNG hardcode text như notification): GROUP_CREATED |
/// MEMBER_ADDED | MEMBER_LEFT | MEMBER_REMOVED | GROUP_RENAMED | ROLE_PROMOTED.
model Message {
  id                     String    @id @default(cuid())
  conversationId         String
  senderId               String? // null cho SYSTEM
  type                   String    @default("TEXT") // TEXT | LINK | SYSTEM | IMAGE | VIDEO | VOICE | FILE | REMINDER | POLL (Phase 2 còn lại: CONTACT)
  body                   String? // nội dung text; với SYSTEM = biến phụ (tên người bị thêm / tên nhóm mới)
  systemEvent            String? // GROUP_CREATED | MEMBER_ADDED | MEMBER_LEFT | MEMBER_REMOVED | GROUP_RENAMED | ROLE_PROMOTED
  linkUrl                String? // type=LINK
  linkText               String? // type=LINK
  linkPreviewTitle       String? // type=LINK — og:title (unfurl server-side lúc gửi, xem lib/link-preview.ts)
  linkPreviewDescription String? // type=LINK — og:description
  linkPreviewImageUrl    String? // type=LINK — og:image (URL tuyệt đối của site ngoài, client load thẳng — không proxy qua server)
  linkPreviewSiteName    String? // type=LINK — og:site_name (fallback hostname)
  attachmentKey          String? // type=IMAGE|VIDEO|VOICE|FILE — key lưu trên local disk (xem lib/chat-storage.ts), KHÔNG lộ ra client
  attachmentName         String? // tên file gốc (IMAGE|VIDEO|FILE)
  attachmentMime         String? // MIME đã validate server-side
  attachmentSize         Int? // bytes
  attachmentDurationSec  Int? // type=VOICE — độ dài ghi âm, tối đa 300s (5 phút)
  replyToId              String? // trả lời 1 tin nhắn — CHỈ trong cùng conversation (validate ở action, không cứng ở DB)
  isForwarded            Boolean   @default(false) // chuyển tiếp từ hội thoại khác (bản sao độc lập nội dung, không giữ liên kết ngược để không lộ quyền xem)
  createdAt              DateTime  @default(now())
  editedAt               DateTime? // set khi sender tự sửa nội dung (chỉ TEXT) — xem editMessage()
  deletedForEveryoneAt   DateTime? // "Delete for everyone" — nội dung đã bị xóa khỏi record này (body/link/attachment clear), hiện tombstone cho TẤT CẢ; sender HOẶC admin nhóm mới làm được
  deletedById            String? // ai bấm "Delete for everyone" (sender hoặc admin)

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Staff?            @relation("MessageSender", fields: [senderId], references: [id])
  deletedBy    Staff?            @relation("MessageDeletedBy", fields: [deletedById], references: [id])
  mentions     MessageMention[]
  replyTo      Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReply")
  reactions    MessageReaction[]
  deletions    MessageDeletion[] // "Delete for me" — mỗi dòng = 1 người đã ẩn tin này riêng cho họ
  pins         PinnedMessage[]
  reminder     Reminder? // type=REMINDER — 1-1, xem Reminder.messageId
  poll         Poll? // type=POLL — 1-1, xem Poll.messageId

  @@index([conversationId, createdAt])
  @@map("message")
}

/// Nhắc hẹn tạo ngay trong ô chat — đăng 1 message TEXT-ish (type=REMINDER) làm thông báo tạo lịch,
/// rồi hệ thống tự "đến hẹn" theo remindAt (check-on-render, xem lib/chat-reminders.ts). recurrence
/// khác ONCE sẽ tự dời remindAt sang kỳ kế tiếp sau mỗi lần đến hẹn (không tạo message mới).
/// Idempotency chống bắn trùng khi nhiều request cùng lúc: dùng optimistic concurrency ngay trên
/// remindAt (UPDATE ... WHERE remindAt = <giá trị cũ đã đọc>) — ai update trước "thắng", ai sau
/// updateMany trả count=0 (WHERE không còn khớp) → tự bỏ qua, không cần bảng log riêng.
model Reminder {
  id             String    @id @default(cuid())
  conversationId String
  messageId      String    @unique
  createdById    String?
  title          String
  remindAt       DateTime // lần đến hẹn KẾ TIẾP (tự dời nếu recurrence lặp lại)
  recurrence     String    @default("ONCE") // ONCE | DAILY | WEEKLY | MONTHLY
  audience       String    @default("ME") // ME (chỉ người tạo) | GROUP (cả hội thoại)
  isActive       Boolean   @default(true) // false khi ONCE đã bắn xong, hoặc bị hủy
  lastFiredAt    DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdBy    Staff?       @relation(fields: [createdById], references: [id])

  @@index([isActive, remindAt])
  @@map("reminder")
}

/// Bình chọn tạo ngay trong ô chat — 1-1 với Message (type=POLL). ≥2 phương án lúc tạo, cho phép
/// thêm sau nếu allowAddOptions. Vote qua PollVote (unique theo option+người — 1 người 1 vote/option;
/// allowMultiple quyết định có được vote nhiều option cùng lúc hay không, enforce ở action).
model Poll {
  id                    String    @id @default(cuid())
  messageId             String    @unique
  question              String
  allowMultiple         Boolean   @default(false)
  anonymous             Boolean   @default(false) // ẩn tên người bình chọn khi xem kết quả
  hideResultsUntilVoted Boolean   @default(false) // ẩn số liệu kết quả cho tới khi CHÍNH người xem đã vote (hoặc poll đã đóng)
  allowAddOptions       Boolean   @default(false) // member khác được thêm phương án mới
  closesAt              DateTime?
  createdById           String?
  createdAt             DateTime  @default(now())

  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdBy Staff?       @relation(fields: [createdById], references: [id])
  options   PollOption[]

  @@map("poll")
}

model PollOption {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  sort      Int
  addedById String? // null = do người tạo poll thêm lúc khởi tạo; có giá trị = member thêm sau (allowAddOptions)
  createdAt DateTime @default(now())

  poll    Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  addedBy Staff?     @relation(fields: [addedById], references: [id])
  votes   PollVote[]

  @@index([pollId])
  @@map("poll_option")
}

model PollVote {
  id           String   @id @default(cuid())
  pollOptionId String
  staffId      String
  createdAt    DateTime @default(now())

  pollOption PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([pollOptionId, staffId])
  @@map("poll_vote")
}

/// "Delete for me" — chỉ ẩn tin nhắn khỏi chính người xóa, không ảnh hưởng người khác (khác hẳn
/// deletedForEveryoneAt ở Message). 1 dòng/người/tin nhắn.
model MessageDeletion {
  id        String   @id @default(cuid())
  messageId String
  staffId   String
  deletedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([messageId, staffId])
  @@map("message_deletion")
}

/// Tin nhắn được ghim lên đầu hội thoại — TỐI ĐA 3 tin/hội thoại tại 1 thời điểm (enforce ở
/// action pinMessage, đếm trước khi insert — đủ an toàn cho quy mô nội bộ ~30-45 người, không cần
/// cơ chế chống race như SpecialOccasionLog).
model PinnedMessage {
  id             String   @id @default(cuid())
  conversationId String
  messageId      String
  pinnedById     String?
  pinnedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy     Staff?       @relation(fields: [pinnedById], references: [id])

  @@unique([conversationId, messageId])
  @@map("pinned_message")
}

/// Nhắc tên trong tin nhắn (@tên / @all). isAll=true → nhắc mọi thành viên (staffId null).
model MessageMention {
  id        String  @id @default(cuid())
  messageId String
  staffId   String? // null nếu isAll
  isAll     Boolean @default(false)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@map("message_mention")
}

/// Reaction (Messenger-style) — mỗi thành viên CHỈ 1 emoji/tin nhắn; đổi emoji = ghi đè (update),
/// bấm lại đúng emoji đang chọn = gỡ (delete). emoji lưu nguyên ký tự Unicode, không giới hạn danh
/// sách cứng — cho phép chọn từ full emoji picker, không chỉ 7 quick-reaction.
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  staffId   String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([messageId, staffId])
  @@map("message_reaction")
}

/// Chống gửi trùng các tin nhắn tự động theo ngày (sinh nhật/thâm niên/sinh nhật công ty) — insert
/// TRƯỚC khi đăng tin (không phải sau) để unique constraint tự chặn race-condition khi nhiều request
/// cùng lúc kích hoạt check (xem lib/occasions.ts).
model SpecialOccasionLog {
  id           String   @id @default(cuid())
  occasionType String // STAFF_BIRTHDAY | WORK_ANNIVERSARY | COMPANY_BIRTHDAY
  refId        String // staffId (2 loại đầu) hoặc hằng số "TCM" (công ty)
  occasionDate DateTime // ngày (00:00 local) đã xử lý — 1 dòng/ngày/loại/đối tượng
  messageId    String? // Message đã tạo, nếu có (giữ log kể cả khi message bị xóa sau này)
  createdAt    DateTime @default(now())

  @@unique([occasionType, refId, occasionDate])
  @@map("special_occasion_log")
}

// ─────────────────────────────────────────────────────────
// MODULE ⑧ KHO — Warehouse · InventoryItem · StockDocument (sổ cái) · StockBalance/ProjectHolding (derived)
// Bất biến: StockBalance & ProjectHolding LUÔN suy ra được từ các StockDocument COMPLETED
// (+ TRANSFER PENDING đã trừ kho nguồn) — cập nhật cùng transaction, không bao giờ sửa tay.
// Chỉ theo dõi SỐ LƯỢNG (Int), không theo dõi giá trị tiền.
// ─────────────────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  location  String?
  isMain    Boolean  @default(false) // hub chính HCM — chỉ 1 kho isMain (enforce app layer)
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances        StockBalance[]
  stockRequestsTo StockRequest[]  @relation("StockRequestToWarehouse")
  documentsFrom   StockDocument[] @relation("StockDocFromWarehouse")
  documentsTo     StockDocument[] @relation("StockDocToWarehouse")
  requests        StockRequest[]  @relation("StockRequestWarehouse")

  @@map("warehouse")
}

/// Kho v2 (spec 27/07/2026): cây danh mục ≤3 cấp thay OptionSet "inventory_category" phẳng (deprecated,
/// giữ dữ liệu cũ). Node GỐC mang code 1 ký tự (P/E/G/C/L/M/O — admin thêm bớt) + cờ isClientOwned
/// (nhóm hàng khách gửi: item bắt buộc gắn khách, có hạn dùng + số phiếu xuất kho của khách).
/// KHÔNG xóa node (mã item đã sinh theo ký tự gốc) — chỉ isActive. Item gắn vào node bất kỳ.
model InventoryCategory {
  id            String   @id @default(cuid())
  parentId      String?
  code          String? // CHỈ node gốc: 1 ký tự A-Z, unique giữa các gốc (validate app layer)
  name          String
  isClientOwned Boolean  @default(false) // chỉ đặt trên node gốc — con/cháu kế thừa khi kiểm tra
  sort          Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   InventoryCategory?  @relation("InventoryCategoryTree", fields: [parentId], references: [id])
  children InventoryCategory[] @relation("InventoryCategoryTree")
  items    InventoryItem[]     @relation("InventoryItemCatNode")

  @@index([parentId])
  @@map("inventory_category_node")
}

/// Danh mục vật tư. partCount>=2 = "bộ tách phần" (KHÔNG stockable — chỉ các phần con mang tồn kho).
/// Quy tắc duy nhất: stockable ⇔ partCount === 1. Phần con: parentItemId set, partNo 1..N,
/// code = `${cha}-${partNo}`. partCount BẤT BIẾN sau khi tạo (đổi cấu trúc = vô hiệu bộ cũ, tạo bộ mới).
/// Kho v2: mỗi item = một LÔ đồng nhất, mã 5 khối `{G}.{ST}.{TT}.{KH3}.{seq3}` sinh ở lib/inventory.ts
/// (buildItemCode; phần con giữ hậu tố `-N`). Trạng thái/tình trạng KHÔNG sửa tay — đổi qua phiếu
/// CHUYỂN ĐỔI LÔ (CONVERT) chạy số lượng giữa 2 mã. Item cũ (trước v2) để các cột mới null.
model InventoryItem {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  categoryId          String? // DEPRECATED (kho v2 dùng catNodeId) — option_set "inventory_category", giữ cột không dùng
  unit                String? // ĐVT free text (cái, bộ, cuộn...)
  isReusable          Boolean   @default(true) // true = Tái sử dụng (phải trả về kho) | false = Dùng một lần
  partCount           Int       @default(1) // 1 = item thường/phần con; 2..4 = bộ cha (không stockable)
  parentItemId        String?
  partNo              Int?
  // ── Kho v2 — thuộc tính lô (nullable: item trước v2 không có) ──
  catNodeId           String? // node cây danh mục v2 (nhóm gốc cho ký tự đầu của mã)
  statusCode          String? // R|P|C|W|L|D — xem ITEM_STATUS_CODES lib/inventory.ts; đổi qua phiếu CONVERT
  conditionCode       String? // B|P|S — brand new / mới một phần / second hand; đổi qua phiếu CONVERT
  ownerClientId       String? // null = hàng TCM (segment mã "TCM"); BẮT BUỘC khi node gốc isClientOwned
  boundProjectId      String? // bắt buộc app-layer khi statusCode=P (hàng theo chính xác dự án)
  expiryDate          DateTime? // hàng khách có date — hết hạn: chặn xuất dùng, chỉ còn phiếu DESTROY
  clientDocNo         String? // số phiếu xuất kho của KHÁCH khi gửi hàng (nhóm isClientOwned)
  /// K4 — MỨC cảnh báo hạn dùng ĐÃ nhắc (YELLOW|ORANGE|RED|EXPIRED). KHÔNG phải cờ một-lần: chỉ
  /// bắn khi mức hiện tại NGHIÊM TRỌNG HƠN mức đã lưu → một lô được nhắc đủ 4 mốc mà không spam.
  /// Gia hạn date thì reset null để nhắc lại từ đầu.
  expiryReminderLevel String?
  seq                 Int? // số thứ tự 001–999 trong tổ hợp mã (suy lại được từ code — lưu để đọc nhanh)
  isActive            Boolean   @default(true)
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  category     OptionItem?        @relation("InventoryItemCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  parent       InventoryItem?     @relation("InventoryItemParts", fields: [parentItemId], references: [id], onDelete: Cascade)
  parts        InventoryItem[]    @relation("InventoryItemParts")
  catNode      InventoryCategory? @relation("InventoryItemCatNode", fields: [catNodeId], references: [id], onDelete: SetNull)
  ownerClient  Client?            @relation("InventoryItemOwnerClient", fields: [ownerClientId], references: [id], onDelete: SetNull)
  boundProject Project?           @relation("InventoryItemBoundProject", fields: [boundProjectId], references: [id], onDelete: SetNull)

  balances       StockBalance[]
  lines          StockDocumentLine[]
  holdings       ProjectHolding[]
  convertLinesIn StockDocumentLine[] @relation("StockLineConvertTo")
  requestLines   StockRequestLine[]

  @@index([parentItemId])
  @@index([categoryId])
  @@index([catNodeId])
  @@index([ownerClientId])
  @@index([statusCode])
  @@map("inventory_item")
}

/// Phiếu kho — sổ cái bất biến. Kho theo type: IMPORT/ADJUST/RETURN → toWarehouseId;
/// ISSUE/DESTROY → fromWarehouseId; TRANSFER → cả hai; CONVERT (chuyển đổi lô, kho v2) →
/// fromWarehouseId (trừ lô nguồn + cộng lô đích TRONG CÙNG kho đó, dòng mang convertToItemId).
/// Sửa sai phiếu COMPLETED = tạo phiếu ADJUST bù (note tham chiếu mã phiếu), KHÔNG edit/xóa.
/// CANCELED chỉ cho TRANSFER đang PENDING (hoàn tồn nguồn).
model StockDocument {
  id                   String    @id @default(cuid())
  code                 String    @unique // {NK|DC|CK|XE|TH|CD|XH}-{YYMM}-{seq3}, retry P2002 khi trùng
  type                 String // IMPORT | ADJUST | TRANSFER | ISSUE | RETURN | CONVERT | DESTROY
  status               String    @default("COMPLETED") // PENDING (chỉ TRANSFER) | COMPLETED | CANCELED
  fromWarehouseId      String?
  toWarehouseId        String?
  projectId            String? // bắt buộc khi ISSUE | RETURN | LOSS; với HOLDING = dự án NHẬN
  /// K4 — phiếu CH (chuyển đồ hiện trường A→B): dự án GỬI. projectId để là bên NHẬN, nhờ vậy bộ
  /// nhắc trả đồ dùng lại nguyên vẹn (nó lọc theo projectId + holding > 0).
  fromProjectId        String?
  expectedReturnAt     DateTime? // ISSUE có dòng tái sử dụng — mốc nhắc trả đồ
  returnReminderSentAt DateTime? // idempotent no-cron — reset khi đổi expectedReturnAt
  note                 String?
  createdById          String?
  confirmedById        String? // bên nhận TRANSFER
  confirmedAt          DateTime?
  canceledById         String?
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  fromWarehouse Warehouse?          @relation("StockDocFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?          @relation("StockDocToWarehouse", fields: [toWarehouseId], references: [id])
  project       Project?            @relation("StockDocProject", fields: [projectId], references: [id], onDelete: SetNull)
  fromProject   Project?            @relation("StockDocFromProject", fields: [fromProjectId], references: [id], onDelete: SetNull)
  createdBy     Staff?              @relation("StockDocCreatedBy", fields: [createdById], references: [id])
  confirmedBy   Staff?              @relation("StockDocConfirmedBy", fields: [confirmedById], references: [id])
  canceledBy    Staff?              @relation("StockDocCanceledBy", fields: [canceledById], references: [id])
  lines         StockDocumentLine[]
  requests      StockRequest[]

  @@index([type, status])
  @@index([projectId])
  @@index([status, expectedReturnAt])
  @@map("stock_document")
}

model StockDocumentLine {
  id               String  @id @default(cuid())
  documentId       String
  itemId           String
  quantity         Int // luôn > 0; riêng ADJUST cho phép âm (điều chỉnh giảm), khác 0
  receivedQuantity Int? // TRANSFER — bên nhận ghi thực nhận (≤ quantity); chênh lệch hiển thị vĩnh viễn
  convertToItemId  String? // CONVERT (kho v2): lô ĐÍCH nhận số lượng — itemId là lô nguồn bị trừ
  note             String?
  sort             Int     @default(0)

  document      StockDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item          InventoryItem  @relation(fields: [itemId], references: [id])
  convertToItem InventoryItem? @relation("StockLineConvertTo", fields: [convertToItemId], references: [id], onDelete: SetNull)

  // K5 đã BỎ @@unique([documentId, itemId]): một lô ra hiện trường có thể về kho thành nhiều
  // tình trạng (2 dòng cùng itemId nguồn, khác convertToItemId đích). Chống trùng nay ở parseLines
  // — theo CẶP (item, trạng thái đích, tình trạng đích) với phiếu trả, theo item với phiếu khác.
  @@index([documentId, itemId])
  @@map("stock_document_line")
}

/// Tồn kho hiện tại — derived, cập nhật cùng transaction với phiếu. Guard chống âm kho:
/// updateMany({ where: { quantity: { gte: qty } }, data: { decrement } }) — count 0 → rollback.
model StockBalance {
  id          String @id @default(cuid())
  warehouseId String
  itemId      String
  quantity    Int    @default(0)

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId])
  @@map("stock_balance")
}

/// Kho v2 — K2: ĐỀ XUẤT kho (tầng người, đặt TRÊN sổ cái). Tồn kho KHÔNG đổi ở bước đề xuất/duyệt;
/// chỉ khi thủ kho xác nhận thực tế mới sinh StockDocument (documentId) và ghi sổ.
///   ISSUE : OPE đề xuất → Account PIC (hoặc AD/AM) duyệt → thủ kho xác nhận thực xuất → phiếu XE
///   INTAKE: PUR/OPE/Account báo hàng về (nối PO hoặc hàng khách gửi hoặc đồ site quay về)
///           → thủ kho xác nhận thực nhập → phiếu NK. KHÔNG có bước duyệt (spec workflow c).
model StockRequest {
  id               String    @id @default(cuid())
  code             String    @unique // {DX|DN}-{YYMM}-{seq3}, retry P2002 khi trùng
  type             String // ISSUE | INTAKE
  status           String    @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | CANCELED | DONE
  warehouseId      String // ISSUE = kho xuất; INTAKE = kho nhận; RESERVE = kho đang giữ; TRANSFER = kho NGUỒN
  /// K4 — TRANSFER (đề xuất chuyển kho): kho ĐÍCH. Các loại khác để null.
  toWarehouseId    String?
  projectId        String? // bắt buộc khi ISSUE
  purchaseOrderId  String? // INTAKE từ PO (module 🛒) — chỉ để đối chiếu, PO vẫn là làn cam kết riêng
  expectedReturnAt DateTime? // ISSUE có dòng tái sử dụng — chép sang phiếu XE lúc xác nhận
  note             String?
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedAt       DateTime?
  rejectReason     String?
  confirmedById    String? // thủ kho
  confirmedAt      DateTime?
  canceledById     String?
  canceledAt       DateTime?
  documentId       String? // phiếu kho sinh ra khi xác nhận — mốc đối chiếu đề xuất ↔ sổ cái
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  warehouse     Warehouse          @relation("StockRequestWarehouse", fields: [warehouseId], references: [id])
  toWarehouse   Warehouse?         @relation("StockRequestToWarehouse", fields: [toWarehouseId], references: [id])
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdBy     Staff?             @relation("StockRequestCreatedBy", fields: [createdById], references: [id])
  approvedBy    Staff?             @relation("StockRequestApprovedBy", fields: [approvedById], references: [id])
  rejectedBy    Staff?             @relation("StockRequestRejectedBy", fields: [rejectedById], references: [id])
  confirmedBy   Staff?             @relation("StockRequestConfirmedBy", fields: [confirmedById], references: [id])
  canceledBy    Staff?             @relation("StockRequestCanceledBy", fields: [canceledById], references: [id])
  document      StockDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  lines         StockRequestLine[]

  @@index([type, status])
  @@index([projectId])
  @@map("stock_request")
}

model StockRequestLine {
  id                String  @id @default(cuid())
  requestId         String
  itemId            String
  quantity          Int // số đề xuất (>0)
  confirmedQuantity Int? // thủ kho ghi số thực xuất/thực nhập (≤ quantity); chênh lệch hiện vĩnh viễn
  note              String?
  sort              Int     @default(0)

  request StockRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([requestId, itemId])
  @@map("stock_request_line")
}

/// Đồ TÁI SỬ DỤNG đang ở hiện trường theo dự án = Σ ISSUE − Σ RETURN (chỉ dòng isReusable).
model ProjectHolding {
  id        String @id @default(cuid())
  projectId String
  itemId    String
  quantity  Int    @default(0)

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([projectId, itemId])
  @@map("project_holding")
}

// ─────────────────────────────────────────────────────────
// MODULE ⑤ NHÂN SỰ — Chấm công & Ca làm việc
// Khung chuẩn 40h/tuần (2 ca × 4h, T2–T6); xếp bù T7/CN bằng đổi ca — KHÔNG tính tăng ca.
// Công tính lương = lịch tuần đã CONFIRM − ngoại lệ (leaveTypeId). 1 ca 4h = 0.5 ngày phép.
// ─────────────────────────────────────────────────────────

/// Danh mục khung ca — admin định nghĩa trong Settings, trưởng bộ phận chỉ chọn gắn vào ngày.
model WorkShift {
  id        String   @id @default(cuid())
  code      String   @unique // SANG | CHIEU | TOI | ...
  name      String
  startTime String // "HH:mm" — app không dùng timezone, giờ địa phương
  endTime   String // "HH:mm"
  hours     Float    @default(4)
  sort      Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ShiftAssignment[]

  @@map("work_shift")
}

/// Lịch tuần của 1 bộ phận. weekStart = Thứ 2 00:00 local. Confirm → notify từng NV có ca;
/// sửa sau confirm được phép — UI nhắc confirm lại (notification SCHEDULE_UPDATED).
model ScheduleWeek {
  id            String    @id @default(cuid())
  departmentId  String
  weekStart     DateTime
  status        String    @default("DRAFT") // DRAFT | CONFIRMED
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  department  Department        @relation(fields: [departmentId], references: [id])
  confirmedBy Staff?            @relation("ScheduleWeekConfirmedBy", fields: [confirmedById], references: [id])
  assignments ShiftAssignment[]

  @@unique([departmentId, weekStart])
  @@map("schedule_week")
}

/// 1 ô ca của 1 NV trong 1 ngày. leaveTypeId null = làm bình thường (giờ công = shift.hours);
/// set = ca nghỉ theo loại (option_set "leave_type": ANNUAL/SICK/UNPAID/ABSENT/OTHER — OTHER bắt buộc note).
model ShiftAssignment {
  id          String   @id @default(cuid())
  weekId      String
  staffId     String
  date        DateTime // 00:00 local, nằm trong tuần của weekId
  shiftId     String
  leaveTypeId String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  week      ScheduleWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  staff     Staff        @relation("ShiftAssignmentStaff", fields: [staffId], references: [id])
  shift     WorkShift    @relation(fields: [shiftId], references: [id])
  leaveType OptionItem?  @relation("ShiftAssignmentLeaveType", fields: [leaveTypeId], references: [id], onDelete: SetNull)

  @@unique([staffId, date, shiftId])
  @@index([weekId])
  @@index([staffId, date])
  @@map("shift_assignment")
}

// ─────────────────────────────────────────────────────────
// MODULE ③ — Sub-module PLANNING (tab trước Operations trong workspace dự án)
// Flow: nhận Brief (job tự sinh khi Order PLANNING được gửi — mirror Creative spawn) →
// Manager (= Department PLANNING.leadStaffId) giao từng khâu hoặc cả flow cho 1 người →
// RESEARCH → DESIGN_BRIEF → PROPOSAL (version 1/2/3... Manager review nội bộ, thêm vòng được) →
// Manager confirm FINAL PROPOSAL → tự ghi link version cuối về ProjectOrder (resultLinkUrl + DONE)
// + notification cho Account đã ORDER.
// ─────────────────────────────────────────────────────────

/// 1 job Planning của 1 dự án. orderId unique → tối đa 1 job sinh từ Order; null = tạo tay.
model PlanningJob {
  id                 String    @id @default(cuid())
  projectId          String
  orderId            String?   @unique // ProjectOrder(PLANNING) nguồn
  briefLinkUrl       String? // snapshot lúc nhận (order.briefLinkUrl ?? project.briefLinkUrl)
  briefNote          String? // thông tin brief thêm từ Order (extraBriefInfo)
  requestedById      String? // Account đã ORDER (order.sentById ?? project.ownerId) — nơi trả FINAL PROPOSAL
  finalConfirmedById String?
  finalConfirmedAt   DateTime? // set khi Manager confirm FINAL — job khóa lại (read-only)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order            ProjectOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  requestedBy      Staff?        @relation("PlanningJobRequestedBy", fields: [requestedById], references: [id])
  finalConfirmedBy Staff?        @relation("PlanningJobFinalConfirmedBy", fields: [finalConfirmedById], references: [id])

  stages   PlanningStage[]
  versions PlanningProposalVersion[]

  @@index([projectId])
  @@map("planning_job")
}

/// Phiếu XIN MƯỢN NGƯỜI làm Planning từ team khác (chốt 05/08/2026).
///
/// Từ đợt này ô "Giao cho" của tab Planning CHỈ hiện nhân sự thuộc team sở hữu dự án. Muốn dùng
/// người của team khác thì trưởng team đi mượn lập phiếu này, và TRƯỞNG TEAM ĐƯỢC MƯỢN là người
/// đồng ý — đồng ý thì phải CHỌN ĐÍCH DANH người cho mượn luôn, chứ không đồng ý chung chung.
///
/// ⚠ Không có ràng buộc unique cho "mỗi dự án chỉ một phiếu chờ": SQLite không làm được unique có
/// điều kiện (chỉ áp cho status = PENDING). Chống trùng nằm ở `createLoanRequest`.
model PlanningLoanRequest {
  id         String @id @default(cuid())
  projectId  String
  fromTeamId String // team đi mượn = team sở hữu dự án
  toTeamId   String // team được mượn
  status     String @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELED
  reason     String // lý do xin mượn — bắt buộc, để trưởng team kia có căn cứ mà quyết

  requestedById String
  requestedAt   DateTime @default(now())

  decidedById  String?
  decidedAt    DateTime?
  lentStaffId  String? // người được cho mượn — chỉ có khi APPROVED
  decisionNote String? // lý do từ chối — bắt buộc khi REJECTED

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromTeam    Team    @relation("LoanFromTeam", fields: [fromTeamId], references: [id])
  toTeam      Team    @relation("LoanToTeam", fields: [toTeamId], references: [id])
  requestedBy Staff   @relation("LoanRequestedBy", fields: [requestedById], references: [id])
  decidedBy   Staff?  @relation("LoanDecidedBy", fields: [decidedById], references: [id])
  lentStaff   Staff?  @relation("LoanLentStaff", fields: [lentStaffId], references: [id])

  @@index([projectId, status])
  @@index([toTeamId, status])
  @@map("planning_loan_request")
}

/// 1 khâu của job — 3 khâu cố định RESEARCH | DESIGN_BRIEF | PROPOSAL, tạo sẵn cùng job.
/// Mỗi khâu: giao cho ai + timeline expect; hoàn thành = link kết quả + giờ (bội 0.25, tối thiểu 0.25).
/// Khâu PROPOSAL không dùng resultLinkUrl — kết quả đi qua bảng version (nhiều vòng review).
model PlanningStage {
  id            String    @id @default(cuid())
  jobId         String
  stage         String // RESEARCH | DESIGN_BRIEF | PROPOSAL
  sort          Int       @default(0)
  assigneeId    String?
  assignedById  String?
  assignedAt    DateTime?
  dueAt         DateTime? // timeline expect nhận lại kết quả
  resultLinkUrl String?
  hoursSpent    Float? // bội số 0.25
  completedAt   DateTime?
  note          String?

  job        PlanningJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignee   Staff?      @relation("PlanningStageAssignee", fields: [assigneeId], references: [id])
  assignedBy Staff?      @relation("PlanningStageAssignedBy", fields: [assignedById], references: [id])

  @@unique([jobId, stage])
  @@index([assigneeId])
  @@map("planning_stage")
}

/// 1 version Proposal (đánh số 1/2/3...). Manager review: NEEDS_REVISION (kèm feedback, mở vòng mới)
/// hoặc FINAL (chốt — trả cho Account). Nộp version mới = thêm vòng review.
model PlanningProposalVersion {
  id            String    @id @default(cuid())
  jobId         String
  versionNo     Int
  resultLinkUrl String
  hoursSpent    Float? // giờ làm cho riêng version này — bội số 0.25
  submittedById String?
  submittedAt   DateTime  @default(now())
  status        String    @default("IN_REVIEW") // IN_REVIEW | NEEDS_REVISION | FINAL
  reviewNote    String? // feedback của Manager khi yêu cầu vòng mới
  reviewedById  String?
  reviewedAt    DateTime?

  job         PlanningJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submittedBy Staff?      @relation("ProposalVersionSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  Staff?      @relation("ProposalVersionReviewedBy", fields: [reviewedById], references: [id])

  @@unique([jobId, versionNo])
  @@map("planning_proposal_version")
}

// ─────────────────────────────────────────────────────────
// Module ⑥ KPI — Khung lương 75/25 (fix 75% + quỹ performance 25% chia theo matrix điểm).
// Quyết định BoD: quỹ zero-sum phase 1 (floor_factor=cap_factor=1.0 trong Setting kpi.* — engine hệ số
// margin vẫn build sẵn, bật co giãn sau bằng cách hạ floor_factor, không cần sửa code).
// Pool grain: Account = TEAM:A1/A2/A3 (Project.ownerTeamId); các phòng khác = DEPT:<code>.
// Lương lưu theo VỊ TRÍ (không cá nhân) — ràng buộc no-RBAC, mirror CreativeSalaryBudget.

/// Lương full (100%) theo vị trí × phòng ban × kỳ. 75/25 tách bằng setting kpi.pool_percent.
model PositionSalary {
  id             String   @id @default(cuid())
  positionTitle  String // khớp Staff.title
  departmentCode String // ACCOUNT | PLANNING | CREATIVE | OPE | PRO
  periodCode     String // "2026-M07" — kỳ áp dụng; resolve = dòng có periodCode lớn nhất ≤ kỳ đang tính
  monthlySalary  BigInt // VND/tháng full cho MỘT người ở vị trí này
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([positionTitle, departmentCode, periodCode])
  @@map("position_salary")
}

/// Tiêu chí đánh giá — catalog admin xây dần. KHÔNG hard-delete: vô hiệu hóa + period bounds;
/// lịch sử đã chốt được bảo vệ thêm bởi snapshot KpiPeriod.resultJson.
model KpiCriterion {
  id               String   @id @default(cuid())
  code             String   @unique
  nameVi           String
  nameEn           String?
  description      String?
  appliesTo        String   @default("ALL") // ALL | ACCOUNT (phủ A1-3) | PLANNING | CREATIVE | OPE | PRO | LEAD
  weight           Float    @default(1)
  scaleMax         Int      @default(5)
  sourceType       String   @default("MANUAL") // MANUAL | AUTO
  autoKey          String? // ATTENDANCE | CREATIVE_ONTIME — chỉ khi sourceType=AUTO
  sort             Int      @default(0)
  isActive         Boolean  @default(true)
  activeFromPeriod String? // periodCode "YYYY-Mmm"; null = từ đầu
  activeToPeriod   String? // null = chưa kết thúc
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scores KpiScore[]

  @@map("kpi_criterion")
}

/// Điểm 1 NV × 1 tiêu chí × 1 kỳ. AUTO criteria được prefill nhưng vẫn lưu thành row khi save
/// (lead sửa được; kỳ đã chốt đọc từ snapshot, không đọc lại bảng này).
model KpiScore {
  id          String   @id @default(cuid())
  criterionId String
  staffId     String
  periodCode  String
  score       Float
  note        String?
  scoredById  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criterion KpiCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  staff     Staff        @relation("KpiScoreStaff", fields: [staffId], references: [id], onDelete: Cascade)
  scoredBy  Staff?       @relation("KpiScoreScoredBy", fields: [scoredById], references: [id])

  @@unique([criterionId, staffId, periodCode])
  @@index([staffId, periodCode])
  @@map("kpi_score")
}

/// Trạng thái + snapshot chốt kỳ cho 1 pool. OPEN = tính live; CLOSED = render/export từ resultJson
/// (mirror CostSheetRevision.snapshotJson) — đổi setting/điểm sau khi chốt KHÔNG đổi số đã trả.
model KpiPeriod {
  id             String    @id @default(cuid())
  periodCode     String
  poolKey        String // "TEAM:A1" | "DEPT:CREATIVE"
  status         String    @default("OPEN") // OPEN | CLOSED
  teamFactor     Float?
  poolAmount     BigInt?
  marginWeighted Float?
  resultJson     String? // toàn bộ output computeKpiAllocation của pool lúc chốt
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  closedBy Staff? @relation("KpiPeriodClosedBy", fields: [closedById], references: [id])

  @@unique([periodCode, poolKey])
  @@map("kpi_period")
}

// ─────────────────────────────────────────────────────────
// KNOWLEDGE BASE THEO KHÁCH HÀNG (H2)
//
// Khác hẳn `KbDocument` (/kb) — đó là thư viện dùng chung toàn công ty. Đây là kho kiến thức
// RIÊNG của từng khách: thông tin chung, brand guideline, các term đặc thù, dạng bài học chia
// theo topic để nhân viên đọc/nắm trước khi làm project cho khách đó.
//
// NEO VÀO NHÓM KHI KHÁCH CÓ NHÓM: 4 pháp nhân AEON dùng chung một kho — PIC nạp một lần,
// nhân viên học một lần là đủ cho cả 4. Khách lẻ thì neo vào chính khách.
// ─────────────────────────────────────────────────────────

/// "Không gian KB" của MỘT đối tượng: hoặc 1 nhóm, hoặc 1 khách lẻ.
///
/// XOR (đúng một trong hai cột) được ép ở `getOrCreateKbSpace` — đường ghi DUY NHẤT tạo space.
/// Hai `@unique` một-cột bảo đảm mỗi clientId/groupId cụ thể chỉ có tối đa một space; SQLite coi
/// các NULL là khác nhau nên nhiều space khách-lẻ vẫn sống chung trong bảng.
///
/// Trang KB resolve đối tượng MỖI request (`resolveKbAnchor`) — khách vào/ra nhóm là tự nhìn
/// thấy đúng kho của mình, KHÔNG copy dữ liệu. Space cũ của khách lẻ vẫn còn nguyên trong DB,
/// chỉ bị ẩn khi khách đang thuộc nhóm; gỡ khỏi nhóm thì thấy lại.
model ClientKbSpace {
  id          String   @id @default(cuid())
  clientId    String?  @unique
  groupId     String?  @unique
  generalNote String? // "Thông tin chung" PIC tự viết, bổ sung cho hồ sơ khách đã có trong CRM
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client  Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group   ClientGroup?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topics  ClientKbTopic[]
  sources ClientKbSource[]

  @@map("client_kb_space")
}

/// Nhóm bài học theo CHỦ ĐỀ. Quiz của topic (H3) sẽ treo thẳng vào đây, không có bảng Quiz riêng.
model ClientKbTopic {
  id        String   @id @default(cuid())
  spaceId   String
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space     ClientKbSpace      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  lessons   ClientKbLesson[]
  questions ClientKbQuestion[]
  attempts  ClientKbAttempt[]

  @@index([spaceId, sort])
  @@map("client_kb_topic")
}

/// Bài học. Nội dung là JSON BLOCKS có cấu trúc (heading/paragraph/bullets/terms) — KHÔNG phải
/// markdown/HTML. Repo cố ý không có markdown renderer (chống XSS, xem ai-shared.tsx); block
/// được render bằng JSX text node nên React tự escape. Zod validate ở MỌI đường ghi.
model ClientKbLesson {
  id          String   @id @default(cuid())
  topicId     String
  title       String
  blocksJson  String   @default("[]")
  status      String   @default("DRAFT") // DRAFT | PUBLISHED — người học chỉ thấy PUBLISHED
  source      String   @default("MANUAL") // MANUAL | AI — nguồn sinh lần đầu (AI ở H3)
  sort        Int      @default(0)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic     ClientKbTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  updatedBy Staff?        @relation("ClientKbLessonUpdatedBy", fields: [updatedById], references: [id])

  @@index([topicId, sort])
  @@map("client_kb_lesson")
}

/// Tài liệu nguồn: brand guideline, brief khách gửi từ trước tới giờ. Vừa để người đọc tải về,
/// vừa là NGUYÊN LIỆU cho phần sinh bài bằng AI ở H3 (trích text qua lib/ai/extract-text.ts).
/// File nằm ở storage/client-kb-uploads, chỉ đọc qua route có auth /api/client-kb/[id].
model ClientKbSource {
  id           String   @id @default(cuid())
  spaceId      String
  kind         String // BRAND_GUIDELINE | BRIEF | OTHER — hard-code vì đi vào logic prompt AI
  fileKey      String
  fileMime     String
  fileName     String
  fileSize     Int
  note         String?
  uploadedById String?
  createdAt    DateTime @default(now())

  space      ClientKbSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  uploadedBy Staff?        @relation("ClientKbSourceUploadedBy", fields: [uploadedById], references: [id])

  @@index([spaceId, kind])
  @@map("client_kb_source")
}

/// Câu hỏi kiểm tra của MỘT chủ đề. KHÔNG có model Quiz riêng: "quiz của chủ đề" = tập câu hỏi
/// `isActive` của chủ đề đó — chốt ở kế hoạch H3 để không đẻ thêm một tầng chỉ để đặt tên.
///
/// ⚠ `correctIndex` KHÔNG BAO GIỜ được select xuống client trước khi nộp bài. Chấm điểm chạy
/// hoàn toàn phía server (`gradeQuiz`), giống nguyên tắc "không tin số từ client" của CO/CE.
/// Câu dở thì đặt `isActive=false` chứ đừng xoá — xoá là phá luôn `answersJson` của các lượt cũ.
model ClientKbQuestion {
  id           String   @id @default(cuid())
  topicId      String
  prompt       String
  optionsJson  String // JSON mảng đúng 4 phương án, validate bằng Zod ở mọi đường ghi
  correctIndex Int
  explanation  String?
  source       String   @default("MANUAL") // MANUAL | AI
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  topic ClientKbTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, isActive])
  @@map("client_kb_question")
}

/// Một LƯỢT làm bài. Giữ MỌI lượt (không ghi đè): "đã đạt chủ đề" = tồn tại một lượt `passed`.
///
/// ⚠ `passPct` chốt NGƯỠNG TẠI THỜI ĐIỂM CHẤM. BGĐ đổi setting `clients.kb_pass_pct` về sau
/// KHÔNG được chấm lại quá khứ — người đã đạt vẫn đạt, kết quả cũ là bằng chứng không đổi.
model ClientKbAttempt {
  id          String   @id @default(cuid())
  topicId     String
  staffId     String
  score       Int
  total       Int
  passPct     Int
  passed      Boolean
  answersJson String // JSON: { questionId: chỉ số phương án đã chọn } — để xem lại bài đã làm
  createdAt   DateTime @default(now())

  topic ClientKbTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  staff Staff         @relation("ClientKbAttemptStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([topicId, staffId])
  @@index([staffId, passed])
  @@map("client_kb_attempt")
}

// ─────────────────────────────────────────────────────────
// CHI PHÍ VĂN PHÒNG (Overhead costs) — không đánh số module vì nằm ngoài chuỗi ①…⑨ nghiệp vụ dự án
//
// Nghiệp vụ thật (file `2026_HR_Chi phi van phong thực tế`): đầu năm chốt một bản ngân sách gồm ~25
// khoản chi, mỗi khoản có mã PID (TCM26-01…) và 12 con số theo tháng. Sau đó HR tự chi trong ngân
// sách; VƯỢT thì phải giải trình chứ KHÔNG bị chặn — file gốc đã có 2 khoản "còn lại" âm kèm lý do.
//
// Năm 2026 import từ Excel (BOD đã duyệt ngoài app). Từ 2027: nhân bản số tháng 12 năm đang chạy →
// HR Manager sửa/thêm/bớt → CFO duyệt → CEO duyệt là KHOÁ.
// ─────────────────────────────────────────────────────────

/// Bản ngân sách của MỘT năm tài chính.
model OverheadBudget {
  id            String  @id @default(cuid())
  fiscalYear    Int     @unique
  /// DRAFT → PENDING_CFO → PENDING_CEO → LOCKED, hoặc REJECTED (CFO/CEO trả về, HR sửa rồi trình lại).
  /// Bản 2026 import từ Excel vào thẳng LOCKED vì BOD đã duyệt ngoài app.
  status        String  @default("DRAFT")
  /// storageKey file Excel gốc đã import (storage/ai-uploads) — giữ để đối chiếu về sau.
  sourceFileKey String?
  note          String?

  submittedAt     DateTime?
  submittedById   String?
  cfoApprovedAt   DateTime?
  cfoApprovedById String?
  ceoApprovedAt   DateTime?
  ceoApprovedById String?
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submittedBy   Staff?         @relation("OverheadBudgetSubmittedBy", fields: [submittedById], references: [id])
  cfoApprovedBy Staff?         @relation("OverheadBudgetCfoBy", fields: [cfoApprovedById], references: [id])
  ceoApprovedBy Staff?         @relation("OverheadBudgetCeoBy", fields: [ceoApprovedById], references: [id])
  rejectedBy    Staff?         @relation("OverheadBudgetRejectedBy", fields: [rejectedById], references: [id])
  items         OverheadItem[]

  @@map("overhead_budget")
}

/// Một KHOẢN CHI trong ngân sách năm (1 dòng của sheet "Total 2026").
model OverheadItem {
  id            String  @id @default(cuid())
  budgetId      String
  /// Mã hiển thị kiểu "TCM26-01".
  /// ⚠ CHỈ ĐỂ HIỂN THỊ — khoá liên kết tiền là `id`. Repo đã trả giá đúng bài này với
  /// `CostLine.itemCode` và phải thêm `stableKey` (xem src/lib/finance.ts): mã do người gõ thì đổi
  /// lúc nào cũng được, dùng nó nối tiền là mất dấu khoản chi.
  pidCode       String
  name          String
  /// "CHI PHÍ THUÊ - MƯỚN - VP" | "DI CHUYỂN - VẬN HÀNH" | "CP VẬN HÀNH" | "LƯƠNG - CHÍNH SÁCH PHÚC LỢI"…
  /// Nhãn tự do theo file gốc, KHÔNG phải OptionSet — danh mục này do kế toán tự đặt theo từng năm.
  categoryLabel String
  /// "Hàng tháng" | "Khi phát sinh" | "1 năm/lần" — cột "Loại đề nghị" của file gốc.
  requestKind   String  @default("MONTHLY")
  /// MANUAL = kế toán nhập thực chi · PAYROLL = số thực chi đọc từ module ⑦ Lương (chưa làm).
  /// 3 khoản lương/BHXH/công đoàn để PAYROLL: hiện chỉ hiện ngân sách, ô thực chi TRỐNG và KHÔNG
  /// cho nhập tay — có hai nguồn số cho cùng một khoản là chắc chắn lệch.
  actualSource  String  @default("MANUAL")
  sort          Int     @default(0)
  /// Bớt khoản = tắt cờ này, KHÔNG xoá — các năm trước còn khoản chi trỏ vào (mirror Vendor/ClientGroup).
  isActive      Boolean @default(true)
  note          String?

  budget       OverheadBudget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetMonths OverheadBudgetMonth[]
  spends       OverheadSpend[]

  @@unique([budgetId, pidCode])
  @@index([budgetId])
  @@map("overhead_item")
}

/// Ngân sách của một khoản trong MỘT tháng.
/// Một dòng cho mỗi (khoản × tháng) thay vì 12 cột — đúng cách `CreativeSalaryBudget` đang làm
/// (@@unique([positionTitle, periodCode])), và là cách duy nhất lọc/tổng hợp theo tháng mà không
/// phải viết 12 nhánh if.
model OverheadBudgetMonth {
  id     String @id @default(cuid())
  itemId String
  month  Int // 1..12
  amount BigInt @default(0)

  item OverheadItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, month])
  @@map("overhead_budget_month")
}

/// MỘT LẦN CHI thực tế. Vòng đời + đường đảo mượn nguyên khuôn `VendorPayment`.
model OverheadSpend {
  id           String    @id @default(cuid())
  itemId       String
  month        Int // 1..12 — tháng ghi nhận chi phí, KHÔNG nhất thiết trùng tháng thanh toán
  name         String
  expectedDate DateTime?

  /// Số THỰC TRẢ ra ngoài (chưa gross-up thuế) — đây là con số dùng đối chiếu ngân sách.
  amountNet   BigInt @default(0)
  vat         BigInt @default(0)
  tncn        BigInt @default(0)
  tndn        BigInt @default(0)
  /// Tổng đã gồm phần thuế — chỉ để hiển thị/đối chiếu chứng từ.
  /// ⚠ ĐỪNG lấy cột này làm số so ngân sách: HANDOVER ghi lại vụ lấy nhầm `amount` thay `netAmount`
  /// làm trần, cho chi vượt đúng bằng phần thuế (đo được 70.250.002đ trên T013).
  amountTotal BigInt @default(0)

  /// SCHEDULED (đã lên phiếu, chưa chi) | PAID (kế toán xác nhận đã thanh toán) | CANCELED.
  status   String    @default("SCHEDULED")
  paidDate DateTime?
  paidById String?

  requestedById  String?
  createdById    String?
  /// Bắt buộc khi khoản chi làm vượt ngân sách của khoản đó — "vượt phải giải trình".
  overBudgetNote String?
  cancelNote     String?
  /// Bắt buộc khi bỏ đánh dấu đã thanh toán (PAID → SCHEDULED).
  reverseNote    String?
  /// Ghi chú tự do — cột "GHI CHÚ" của sheet chi tiết (vd "Đang tạm ứng").
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item        OverheadItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  paidBy      Staff?       @relation("OverheadSpendPaidBy", fields: [paidById], references: [id])
  requestedBy Staff?       @relation("OverheadSpendRequestedBy", fields: [requestedById], references: [id])
  createdBy   Staff?       @relation("OverheadSpendCreatedBy", fields: [createdById], references: [id])

  @@index([itemId, month])
  @@index([status])
  @@map("overhead_spend")
}

// ─────────────────────────────────────────────────────────
// MKT POST — bài đăng LinkedIn / Fanpage (không đánh số module, nằm ngoài chuỗi ①…⑨)
//
// Flow: Account viết Ý CHÍNH + ảnh (đã chèn frame NGOÀI app) → AI DeepSeek viết content RIÊNG từng
// kênh → HR sửa bản cuối, copy đăng TAY lên LinkedIn/Fanpage rồi đánh dấu ĐÃ ĐĂNG → hằng quý HR
// upload file export Meta/LinkedIn cho AI phân tích. App KHÔNG gọi API mạng xã hội — đăng tay là
// chủ đích (quyết định chủ dự án 04/08/2026).
// Nhịp mục tiêu: LinkedIn 1 bài/tuần · Fanpage 1–2 bài/tuần (hằng ở lib/mkt.ts).
// ─────────────────────────────────────────────────────────

/// Bài gốc. `keyPoints` là NGUỒN DỮ KIỆN DUY NHẤT mà AI được phép dùng — prompt cấm bịa số liệu
/// ngoài đây, nên ý chính viết sơ sài thì bài AI cũng rỗng theo.
model MktPost {
  id            String   @id @default(cuid())
  title         String
  /// Ý chính gạch đầu dòng do Account viết. Render whitespace-pre-wrap.
  keyPoints     String
  /// OptionItem của set "mkt_content_type" (RECAP|TEASER|BTS|MILESTONE|RECRUIT|OTHER) — đi vào
  /// prompt để AI bám đúng mục đích bài. Nullable ở DB, form BẮT BUỘC chọn.
  contentTypeId String?
  /// Dự án liên quan — TUỲ CHỌN: bài tuyển dụng / kỷ niệm không gắn dự án nào.
  projectId     String?
  /// Link thư mục ảnh gốc trên Drive/OneDrive — tuỳ chọn, chỉ để mở xem.
  driveUrl      String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentType OptionItem?      @relation("MktPostContentType", fields: [contentTypeId], references: [id])
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy   Staff?           @relation("MktPostCreatedBy", fields: [createdById], references: [id])
  images      MktPostImage[]
  variants    MktPostVariant[]

  @@index([projectId])
  @@index([createdAt])
  @@map("mkt_post")
}

/// Ảnh đính kèm bài (đã chèn frame sẵn ngoài app). File nằm ở storage/mkt-uploads, CHỈ đọc qua
/// route có auth /api/mkt-image/[id] — mirror ClientKbSource.
model MktPostImage {
  id           String   @id @default(cuid())
  postId       String
  fileKey      String
  fileMime     String
  fileName     String
  fileSize     Int
  sort         Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())

  post       MktPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploadedBy Staff?  @relation("MktPostImageUploadedBy", fields: [uploadedById], references: [id])

  @@index([postId, sort])
  @@map("mkt_post_image")
}

/// Bản của MỘT kênh. Mỗi bài tối đa 1 dòng/kênh; dòng được tạo lúc createPost theo kênh đã chọn.
model MktPostVariant {
  id           String    @id @default(cuid())
  postId       String
  /// LINKEDIN | FANPAGE — hard-code vì đi thẳng vào prompt AI và phép đếm nhịp đăng, KHÔNG OptionSet.
  channel      String
  /// DRAFT (chưa viết) → AI_DRAFTED (AI đã viết) → POSTED (HR đã đăng tay + đánh dấu).
  /// Đường lùi duy nhất là unmarkPosted. Mọi lần đổi trạng thái đi qua updateMany có status trong
  /// `where` + kiểm count === 0 (khuôn moveBudget, overhead/actions.ts) — chống double-click.
  status       String    @default("DRAFT")
  /// Bản AI trả lần gần nhất — giữ lại để đối chiếu HR đã sửa gì so với máy.
  aiDraft      String?
  aiDraftedAt  DateTime?
  /// Bản CUỐI để copy đi đăng. Bấm AI là GHI ĐÈ cả aiDraft lẫn finalContent (hộp xác nhận cảnh báo).
  finalContent String    @default("")
  postedAt     DateTime?
  /// Link bài đã đăng thật trên kênh — tuỳ chọn, HR dán lúc đánh dấu.
  postUrl      String?
  postedById   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  post     MktPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postedBy Staff?  @relation("MktPostVariantPostedBy", fields: [postedById], references: [id])

  @@unique([postId, channel])
  @@index([channel, status])
  @@index([postedAt])
  @@map("mkt_post_variant")
}

/// Báo cáo insights MỘT quý. `aiResult` là text dài, render whitespace-pre-wrap + nút Copy.
model MktInsightReport {
  id          String    @id @default(cuid())
  year        Int
  quarter     Int // 1..4
  /// Ghi chú HR — đi vào prompt làm ngữ cảnh định tính cho AI.
  note        String?
  /// Kết quả phân tích lần gần nhất; chạy lại là GHI ĐÈ (hộp xác nhận cảnh báo).
  aiResult    String?
  aiRanAt     DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy Staff?           @relation("MktInsightReportCreatedBy", fields: [createdById], references: [id])
  files     MktInsightFile[]

  @@unique([year, quarter])
  @@map("mkt_insight_report")
}

/// File export từ Meta/LinkedIn (xlsx/csv/pdf) — nguyên liệu AI đọc qua lib/ai/extract-text.ts.
/// CỐ Ý không có route tải về: upload chỉ để model đọc, giống file đính kèm của module AI.
model MktInsightFile {
  id           String   @id @default(cuid())
  reportId     String
  /// LINKEDIN | FANPAGE | OTHER — chỉ dùng để ghi header khối text khi ghép prompt.
  channel      String   @default("OTHER")
  fileKey      String
  fileMime     String
  fileName     String
  fileSize     Int
  uploadedById String?
  createdAt    DateTime @default(now())

  report     MktInsightReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedBy Staff?           @relation("MktInsightFileUploadedBy", fields: [uploadedById], references: [id])

  @@index([reportId])
  @@map("mkt_insight_file")
}

// ─────────────────────────────────────────────────────────────────────────────
// TUYỂN DỤNG (sub-module của Nhân sự) — TD-1
// ─────────────────────────────────────────────────────────────────────────────

/// Vị trí đang tuyển + JD của vị trí đó. Quản trị ở /settings/recruit.
///
/// ⚠ CỐ Ý KHÔNG đụng tới `Staff.title` (chuỗi tự do) và KHÔNG dựng danh mục chức danh dùng chung.
/// HANDOVER 10.5 có ghi nợ "nên chuyển title thành option_set + Staff.titleId" — đó là việc đụng
/// vào lương theo vị trí, KPI và Creative cost, không thuộc phạm vi tuyển dụng. Bảng này là danh
/// mục RIÊNG của tuyển dụng, chỉ neo vào org chart qua phòng ban / team / người quản lý.
///
/// JD để thẳng 4 ô văn bản dài chứ không phải JSON block như bài học KB: JD không có cấu trúc
/// lồng nhau, và repo cố ý không có bộ render markdown. Hiển thị bằng `whitespace-pre-wrap`,
/// React tự escape text node.
model JobPosition {
  id     String @id @default(cuid())
  title  String
  /// OPEN = đang tuyển · PAUSED = tạm dừng · CLOSED = đã tuyển xong/huỷ.
  /// Không có đường XOÁ: xoá vị trí đang có ứng viên là mất dấu vết cả kho hồ sơ (mirror ClientGroup).
  status String @default("OPEN")

  departmentId String?
  teamId       String?
  /// Người quản lý trực tiếp của vị trí này. Cùng với trưởng phòng, đây là người NGOÀI HR được
  /// nhìn thấy lương mong muốn của ứng viên (xem lib/recruit.ts → canSeeExpectedSalary).
  hiringManagerStaffId String?

  jdSummary          String?
  jdResponsibilities String?
  jdRequirements     String?
  jdBenefits         String?
  jdUpdatedAt        DateTime?
  jdUpdatedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department    Department? @relation(fields: [departmentId], references: [id])
  team          Team?       @relation(fields: [teamId], references: [id])
  hiringManager Staff?      @relation("JobPositionHiringManager", fields: [hiringManagerStaffId], references: [id])
  jdUpdatedBy   Staff?      @relation("JobPositionJdUpdatedBy", fields: [jdUpdatedById], references: [id])
  candidates    Candidate[]

  @@index([status])
  @@index([departmentId])
  @@map("job_position")
}

/// Mẫu JD dùng lại — HR chọn mẫu để điền sẵn 4 ô JD của một vị trí mới, sau đó sửa tự do.
/// Điền xong là DỮ LIỆU RỜI: sửa mẫu về sau KHÔNG đổi JD của vị trí đã tạo (cố ý — JD đã đăng
/// tuyển không được đổi sau lưng người đang ứng tuyển).
model JdTemplate {
  id                 String   @id @default(cuid())
  name               String
  jdSummary          String?
  jdResponsibilities String?
  jdRequirements     String?
  jdBenefits         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("jd_template")
}

/// Hồ sơ ứng viên. Bị từ chối thì KHÔNG xoá — chuyển `status = "REJECTED"` và vẫn giữ nguyên
/// `positionId`, nhờ vậy kho hồ sơ (/staff/recruit/archive) tìm lại được theo phòng ban / vị trí.
model Candidate {
  id         String @id @default(cuid())
  positionId String

  fullName String
  dob      DateTime? // quy ước UTC-midnight của app (HANDOVER 4.3)
  phone    String?
  email    String?

  /// Ba ô tóm tắt do AI đọc CV điền sẵn, HR sửa lại được. Văn bản thuần, KHÔNG markdown.
  summaryWork   String?
  summarySkills String?
  summaryOther  String?

  /// Lương mong muốn (VND). Tiền = BigInt trong DB theo luật chung (HANDOVER 4.1).
  /// ⚠ Ô này bị GATE Ở TẦNG TRUY VẤN — xem lib/recruit.ts. Không select là không vào HTML.
  expectedSalary BigInt?

  cvFileKey  String
  cvFileName String
  cvFileMime String
  cvFileSize Int
  /// Mốc lần AI đọc CV gần nhất. Null = chưa đọc lần nào (HR nhập tay hoàn toàn).
  aiParsedAt DateTime?

  /// NEW = mới nhận · INTERVIEWING = đã có lịch phỏng vấn · HIRED · REJECTED.
  status       String    @default("NEW")
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  position   JobPosition @relation(fields: [positionId], references: [id])
  decidedBy  Staff?      @relation("CandidateDecidedBy", fields: [decidedById], references: [id])
  createdBy  Staff?      @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  interviews Interview[]

  @@index([positionId, status])
  @@index([status])
  @@map("candidate")
}

/// Một lượt phỏng vấn = một vòng × một người phỏng vấn.
///
/// ⚠ Vòng đời: PENDING (đã gửi yêu cầu, chờ người phỏng vấn xác nhận lịch) → CONFIRMED → DONE
/// (đã chấm điểm). DECLINED = người phỏng vấn báo bận, HR đặt lại lịch khác. Người phỏng vấn CHỈ
/// nhìn được hồ sơ ứng viên của lượt phỏng vấn GẮN TÊN MÌNH — phép kiểm theo bản ghi, không phải
/// theo mã quyền (mirror cách duyệt đề xuất kho theo PIC dự án, HANDOVER 10.11).
model Interview {
  id                 String   @id @default(cuid())
  candidateId        String
  round              Int // 1 | 2 | 3
  interviewerStaffId String
  scheduledAt        DateTime
  durationMin        Int      @default(60)
  /// Phòng họp, địa chỉ, hoặc link họp online. Đi thẳng vào file lịch .ics.
  location           String?

  status        String    @default("PENDING")
  respondedAt   DateTime?
  declineReason String?

  /// Kết quả — PASS | CONSIDER | FAIL. Đây là đề xuất của NGƯỜI PHỎNG VẤN, khác với quyết định
  /// cuối cùng nằm ở Candidate.status (do người có quyền hr.recruit.decide bấm).
  recommendation String?
  strengths      String?
  concerns       String?
  note           String?
  scoredAt       DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer Staff            @relation("InterviewInterviewer", fields: [interviewerStaffId], references: [id])
  createdBy   Staff?           @relation("InterviewCreatedBy", fields: [createdById], references: [id])
  scores      InterviewScore[]

  @@unique([candidateId, round, interviewerStaffId])
  @@index([interviewerStaffId, status])
  @@map("interview")
}

/// Điểm từng tiêu chí của một lượt phỏng vấn.
///
/// ⚠ `criterionCode` là CHUỖI, cố ý KHÔNG phải khoá ngoại sang OptionItem: tiêu chí là danh mục
/// mềm (OptionSet `recruit_criteria`), BGĐ tắt bớt tiêu chí về sau thì phiếu đã chấm vẫn phải đọc
/// được nguyên vẹn. Cùng lý do với việc câu hỏi kiểm tra ở KB-H3 chỉ TẮT chứ không xoá.
model InterviewScore {
  id            String  @id @default(cuid())
  interviewId   String
  criterionCode String
  score         Int // 1..5
  note          String?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, criterionCode])
  @@map("interview_score")
}
