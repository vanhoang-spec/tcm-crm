  introducedClients           Client[]                  @relation("ClientIntroducer")
  clientTransfersRequested    ClientTransfer[]          @relation("TransferRequestedBy")
  clientTransfersApproved     ClientTransfer[]          @relation("TransferApprovedBy")
  careNotes                   CareNote[]                @relation("CareNoteStaff")
  ownedProjects               Project[]                 @relation("ProjectOwner")
  goNogoDecisions             Project[]                 @relation("ProjectGoNogoBy")
  biddingRoundsCreated        BiddingRound[]            @relation("BiddingRoundCreatedBy")
  costSheetOverrides          CostSheet[]               @relation("CostSheetOverrideBy")
  costSheetApprovals          CostSheet[]               @relation("CostSheetApprovedBy")
  contractsConfirmed          Contract[]                @relation("ContractAccountantConfirmedBy")
  acceptanceDocsConfirmed     Contract[]                @relation("ContractAcceptanceDocsConfirmedBy")
  clientAcceptanceConfirmed   Contract[]                @relation("ContractClientAcceptanceConfirmedBy")
  invoicesEntered             Contract[]                @relation("ContractInvoiceBy")
  costSheetRejections         CostSheet[]               @relation("CostSheetRejectedBy")
  notifications               Notification[]            @relation("NotificationRecipient")
  projectOrdersSent           ProjectOrder[]            @relation("ProjectOrderSentBy")
  projectOrdersAccepted       ProjectOrder[]            @relation("ProjectOrderAcceptedBy")
  projectOrdersResultSent     ProjectOrder[]            @relation("ProjectOrderResultSentBy")
  projectOrderAttendances     ProjectOrderAttendee[]
  projectsLed                 Project[]                 @relation("ProjectLeader")
  projectMemberships          ProjectMember[]
  timelineItemsOwned          TimelineItem[]            @relation("TimelineItemOwner")
  timelineItemsOwned2         TimelineItem[]            @relation("TimelineItemOwner2")
  timelineComments            TimelineComment[]         @relation("TimelineCommentStaff")
  costSheetRevisions          CostSheetRevision[]       @relation("CostSheetRevisionCreatedBy")
  costSheetsSentToLiquidation CostSheet[]               @relation("CostSheetSentToLiquidationBy")
  guestInvitesCreated         GuestInvite[]             @relation("GuestInviteCreatedBy")
  creativeTasksAssigned       CreativeTask[]            @relation("CreativeTaskAssignee")
  creativeTasksCd             CreativeTask[]            @relation("CreativeTaskAssignedBy")
  creativeTasksReviewed       CreativeTask[]            @relation("CreativeTaskReviewedBy")
